#!/usr/bin/env bash
# handoff — el estado de un proyecto (.claude/estado/nucleo.md) entre sesiones. Válido en Claude Code, Codex y
# opencode. El modelo redacta un borrador; este CLI decide: valida las cabeceras contra la plantilla, fusiona sin
# tocar Objetivo ni Invariantes, mueve los pasos [x] a diario.md, pliega el rc de `oraculo`, rota copias, recorta
# al tope (NUCLEO_TOPE menos NUCLEO_RESERVA_AGENTES, de la lib) y libera al dueño. Por qué fuera del modelo:
# reescribir el estado entero cada vez es lo que pierde detalle, y el tope y la forma no pueden depender de que el
# modelo se acuerde.
set -euo pipefail

uso() {
  cat <<'EOF'
uso: handoff --desde BORRADOR.md [--raiz DIR | --ranura DIR] [--sesion ID] [--solo] [--commit]
     handoff --proyecto RUTA [--ranura DIR] [--sesion ID] [--json]
     handoff --auto [--raiz DIR] [--sesion ID] [--transcript RUTA] [--motivo stop|compact|fin] [--json] < hook.json
     handoff --iniciar [--raiz DIR]
     handoff --informe TEMA [--raiz DIR]
     handoff --migrar [DIR] [--sesion ID] [--esperado SHA256] [--json]
     handoff --estado [--raiz DIR] [--sesion ID]
     handoff --agentes [--raiz DIR]
     handoff --liberar ID [--raiz DIR]
--desde   fusiona el borrador (secciones «## » de la plantilla; «Pendientes y riesgos» vale por «Pendientes») en
          <raíz>/.claude/estado/nucleo.md: Objetivo e Invariantes del nucleo no se tocan (de Invariantes se añaden las líneas
          nuevas del borrador, sin borrar nunca una); los [x] del Plan pasan a diario.md con su
          comando y el hash de HEAD; el último rc de verificaciones.log se pliega en «Comandos de verificación»;
          «Ficheros tocados» se regenera desde git (cambios desde el handoff anterior y working tree; el texto a mano se conserva);
          una sección vacía del borrador (sin cuerpo o solo comentarios) conserva la del nucleo; para vaciarla
          se escribe «- (nada)»; se guarda nucleo.prev-* (3 copias) y se recorta al tope (menos la reserva del bloque de agentes, para que se inyecte entero) omitiendo secciones enteras (primero las ajenas a la plantilla, desde el final; luego Pendientes, Plan, Ficheros tocados y Comandos); Paso actual se corta por línea, con aviso, y Siguiente acción no se toca. Lo omitido o cortado va entero a diario.md.
  --solo    no fusiona: el borrador sustituye al nucleo (se sigue validando).
  --commit  además hace commit solo de .claude/estado/ (para repos propios); sin él, .claude/estado/ se añade
            a .git/info/exclude.
  --sesion  ID real de la sesión que escribe. Con dueño vigente es obligatorio y debe coincidir;
            sin ID o con otro devuelve 5 sin escribir. En --desde, sin --sesion vale $CLAUDE_CODE_SESSION_ID si existe. No copies el ID de otra sesión desde --estado.
            Al guardar libera ese dueño (o el dueño caducado). Con --desde busca además el transcript de esa sesión
            (${CLAUDE_CONFIG_DIR:-~/.claude}/projects/*/ID.jsonl; el ID solo admite letras, cifras y «-») y deja en el nucleo, bajo el título, la línea
            «> sesión anterior: RUTA · volver: claude --resume ID …» (una sola: cada handoff sustituye la anterior; entra en el tope y no se omite).
            Sin transcript o sin ID no hay línea y no es un error. En modo ESTADO.md no se escribe (es de la persona y va a git).
            Con --desde anota también, justo debajo, «> carpeta de trabajo: RUTA» si el cwd de quien guarda no es donde arranca la sesión
            nueva tras /clear ($CLAUDE_PROJECT_DIR; sin él, ~ en una ranura y la raíz del proyecto): así se retoma en la misma carpeta.
--ranura  solo con --desde: escribe en esa ranura de sesión (~/.claude/estado/sesiones/<id>/) sea cual sea el cwd; es lo que
          dicta el aviso de contexto en una sesión abierta desde ~. Se acepta solo si, resuelta con realpath, es un hijo directo de
          $CLAUDE_HOME/estado/sesiones/ y no contiene enlaces; si no, sale 1 sin escribir. Excluye --raiz y --commit.
--proyecto vincula la sesión de ~ con el repo git de RUTA (vale cualquier carpeta de dentro): desde entonces su estado (hooks, --desde,
          --auto, --estado, agentes) vive en <repo>/.claude/estado/ y la ranura de ~ solo coordina («> proyecto: RAÍZ» y «## Coordinación»).
          Rechaza sin cambiar nada si la sesión no es de ~, si RUTA no es un proyecto válido (raíz de su repo, ruta simple, ni ~ ni ~/.claude)
          o si el proyecto tiene dueño ajeno vigente (5). Proyecto sin estado: lo siembra con el nucleo de la ranura; con estado: ese nucleo
          va al diario.md de la ranura. Reclama el dueño del proyecto (suelta el del anterior si revincula) y lleva el registro de agentes.
          Idempotente. Con --ranura (la propia) vale desde cualquier cwd; sin ella, la ranura es la del claude de esta sesión.
          Sale 3 si la sesión no es de ~, la ruta no es proyecto válido o no hay ranura, 5 con dueño ajeno y 64 sin --sesion (vale
          $CLAUDE_CODE_SESSION_ID). Con --json: {raiz,nucleo,sesion,resultado} (vinculada | vinculada-y-sembrada | vinculada-y-archivada | ya-vinculada).
          Un --raiz explícito en cualquier modo ignora el vínculo.
--auto    lo usa el hook autosave.sh, no el modelo: escribe SOLO la sección «## Último turno (auto)» (la última del nucleo, ≤ 600 B:
          rama, última petición, último mensaje, ficheros tocados y comandos, sacados de git y del transcript; sin modelo) y la marca
          autosave.dirty. Lee el JSON del hook por stdin (session_id, transcript_path, cwd, last_assistant_message, compact_summary,
          hook_event_name); las opciones mandan sobre el JSON. Conserva el mtime de nucleo.md (sigue siendo «la última síntesis del modelo»),
          no rota nucleo.prev-*, no libera al dueño (si no hay dueño vigente, la sesión que escribe lo reclama) y, si el estado está ocupado o es de otra sesión, no hace nada (sale 0). Sin nucleo.md no crea
          nada, salvo en una ranura de ~ con trabajo que anotar. Con --json, {"omitido":"motivo"} o {nucleo,sha256,bytes,motivo}. Un --desde
          posterior conserva la sección (el borrador no la trae) y borra autosave.dirty.
--iniciar crea <raíz>/.claude/estado/nucleo.md desde $CLAUDE_HOME/templates/nucleo.md (el primero del proyecto) y añade
          .claude/estado/ a .git/info/exclude; si ya existe no lo toca (sale 0 y lo dice). En cualquier caso deja
          listos informes/ y checkpoints/ y un .gitignore interno con «*» (nada de ahí va a git).
--informe crea <raíz>/.claude/estado/informes/AAAA-MM-DD-TEMA/ e imprime su ruta absoluta: es donde van los informes,
          briefs y salidas de un agente, en vez del scratchpad. TEMA se sanea (sin «/» ni «..»); si queda vacío, sale 64.
--migrar  archiva el núcleo de DIR en archivo/ del estado real y lo anota en diario; nunca borra.
          Sin DIR archiva únicamente la ranura HOME del proceso actual.
--esperado exige ese SHA256 al archivar, bajo lock; si cambió o no existe devuelve 4.
--json    --desde devuelve {nucleo,sha256,transcript,bytes} del documento guardado (transcript: la ruta o null; bytes: lo escrito); --migrar añade archivo.
--liberar ID libera solamente al dueño cuyo ID coincida; conserva el núcleo.
--agentes tabla del registro persistente; no crea estado ni archiva agentes.
--estado  una línea JSON: raíz, nucleo, bytes, tope, pct, dueño, sha256 y agentes_vivos de --sesion (sin proyecto: {"raiz":null}).
          Con la ranura de esta sesión vinculada a la raíz: los del proyecto, más «sesion» (la ranura) y «vinculado»:true.
Raíz: la del directorio actual (raíz git; no $HOME ni un directorio sin git) o --raiz DIR.
Con ESTADO.md en la raíz y sin nucleo.md, ese es el estado del proyecto y --desde lo fusiona en él (nunca crea nucleo.md):
          Paso actual y Siguiente acción sustituyen a sus viñetas (el Objetivo solo si está vacío o es plantilla RELLENAR; Invariantes solo
          crece con las líneas nuevas, como en nucleo.md); Decisiones, Pendientes (o «Pendientes y riesgos») y Comandos
          de verificación (o «Cómo se comprueba») sustituyen a su sección, y la crean si falta; lo sin equivalente (Plan, Ficheros tocados) se añade como sección propia y se informa. Mismo tope en bytes; lo omitido va a .claude/estado/diario.md y
          la copia previa a .claude/estado/ESTADO.prev-* (3). --iniciar no crea nada (sale 0); --estado añade «modo» y «estado»;
          --solo no aplica (64). Con --json el aviso «supera el tope» va al recibo (campo avisos), no a stderr.
Salida: 0 ok · 2 borrador inválido (stderr nombra la cabecera) · 3 sin proyecto o con enlaces simbólicos en estado/ · 4 nucleo.md cambió durante la
fusión o estado ocupado (reintenta) · 5 dueño ajeno · 1 otro error · 64 uso erróneo.
Sesión en ~: sin proyecto y sin --raiz, el estado de esta sesión vive en su ranura ~/.claude/estado/sesiones/<fecha>-<pid de claude>/
          (pid de CLAUDE_PID o del padre si es claude). las escrituras (--desde, --iniciar, informes) van ahí; --estado da
          {"raiz":null,"sesion":RUTA,"nucleo","bytes","tope","pct","dueno":null}; --commit no aplica (sale 3).
EOF
}

SELF=$(readlink -f -- "$0" 2>/dev/null || realpath -- "$0" 2>/dev/null || printf '%s' "$0")
# shellcheck source=SCRIPTDIR/../hooks/lib/nucleo.sh
. "$(dirname "$SELF")/../hooks/lib/nucleo.sh"
# shellcheck source=SCRIPTDIR/../hooks/lib/agentes.sh
. "$(dirname "$SELF")/../hooks/lib/agentes.sh"
# Lo escrito deja sitio al bloque <agentes> que los SessionStart inyectan con el nucleo: así entra entero.
TOPE=$((NUCLEO_TOPE - NUCLEO_RESERVA_AGENTES))
[ "$TOPE" -gt 0 ] || { echo "uso: handoff: NUCLEO_TOPE=$NUCLEO_TOPE no deja sitio tras la reserva de agentes ($NUCLEO_RESERVA_AGENTES B)" >&2; exit 64; }

die() { local rc=$1; shift; echo "handoff: $*" >&2; exit "$rc"; }
# Avisos de un guardado correcto: uno por elemento. Con --json van al recibo y stderr queda vacío; sin --json, una línea.
AV=()
avisar() { AV+=("$*"); }
avisos_stderr() {
  local j
  { [ "$JSON" != 1 ] && [ "${#AV[@]}" -gt 0 ]; } || return 0
  printf -v j '%s; ' "${AV[@]}"; echo "handoff: ${j%; }" >&2
}
bytes() { printf '%s' "$1" | LC_ALL=C wc -c | tr -d ' '; }
iso_de() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ; }

MODO="" DESDE="" MIGRAR="" TEMA="" PROYECTO_ARG="" RAIZ_ARG="" RANURA_ARG="" SESION="" ESPERADO="" JSON=0 SOLO=0 COMMIT=0 TRANSCRIPT_ARG="" MOTIVO=""
while [ $# -gt 0 ]; do
  case $1 in
    -h | --help) uso; exit 0 ;;
    --migrar)
      MODO=migrar; shift
      if [ $# -gt 0 ] && [[ $1 != --* ]]; then MIGRAR=$1; shift; fi ;;
    --desde | --proyecto | --informe | --raiz | --ranura | --sesion | --liberar | --esperado | --transcript | --motivo)
      [ $# -ge 2 ] || { echo "uso: handoff: a $1 le falta su argumento (handoff --help)" >&2; exit 64; }
      case $1 in
        --desde) MODO=desde; DESDE=$2 ;;
        --proyecto) MODO=proyecto; PROYECTO_ARG=$2 ;;
        --informe) MODO=informe; TEMA=$2 ;;
        --raiz) RAIZ_ARG=$2 ;;
        --ranura) RANURA_ARG=$2 ;;
        --sesion) SESION=$2 ;;
        --liberar) MODO=liberar; SESION=$2 ;;
        --esperado) [ -n "$2" ] || die 64 "--esperado requiere un SHA256"; ESPERADO=$2 ;;
        --transcript) TRANSCRIPT_ARG=$2 ;;
        --motivo) case $2 in stop | compact | fin) MOTIVO=$2 ;; *) die 64 "--motivo: stop, compact o fin" ;; esac ;;
      esac
      shift 2 ;;
    --json) JSON=1; shift ;;
    --estado) MODO=estado; shift ;;
    --auto) MODO=auto; shift ;;
    --agentes) MODO=agentes; shift ;;
    --iniciar) MODO=iniciar; shift ;;
    --solo) SOLO=1; shift ;;
    --commit) COMMIT=1; shift ;;
    *) echo "uso: handoff: opción desconocida «$1» (handoff --help)" >&2; exit 64 ;;
  esac
done
# Sin --sesion, en --desde vale la sesión que corre este Bash (Claude Code la exporta): quien ya es dueño no tiene que repetirla.
[ "$MODO" != desde ] && [ "$MODO" != proyecto ] || [ -n "$SESION" ] || SESION=${CLAUDE_CODE_SESSION_ID:-}
{ [ -z "$TRANSCRIPT_ARG" ] && [ -z "$MOTIVO" ]; } || [ "$MODO" = auto ] || die 64 "--transcript y --motivo solo van con --auto"
[ -n "$MODO" ] || { echo "uso: handoff --desde BORRADOR.md | --iniciar | --informe TEMA | --migrar DIR | --estado (handoff --help)" >&2; exit 64; }

if [ -n "$RANURA_ARG" ]; then
  { [ "$MODO" = desde ] || [ "$MODO" = proyecto ]; } && [ -z "$RAIZ_ARG" ] || die 64 "--ranura solo va con --desde o --proyecto y sin --raiz"
  [ "$COMMIT" -eq 0 ] || die 3 "--commit no aplica al estado de una sesión (no hay repo): no escribo nada"
fi

if [ -n "$ESPERADO" ]; then
  [ "$MODO" = migrar ] && [[ $ESPERADO =~ ^[[:xdigit:]]{64}$ ]] || die 64 "--esperado requiere --migrar y un SHA256 de 64 dígitos hexadecimales"
  ESPERADO=${ESPERADO,,}
fi

# La raíz de proyecto, o rc 1 sin tocar nada (decisión 6: ni $HOME, ni ~/.claude, ni un directorio sin git).
resolver_raiz() {
  # Un --raiz explícito no pasa por el vínculo de la ranura: quien lo da quiere esa raíz (o ninguna, con ~).
  if [ -n "$RAIZ_ARG" ]; then RAIZ=$(CLAUDE_PROJECT_DIR=$RAIZ_ARG NUCLEO_VINCULO=0 nucleo_raiz "$RAIZ_ARG") || RAIZ=""
  else RAIZ=$(nucleo_raiz "$PWD") || RAIZ=""
  fi
  [ -n "$RAIZ" ]
}

# vinculada: VSLOT = la ranura de este proceso si está vinculada a $RAIZ (sin --raiz); vacío si no. Distingue «sesión de ~
# vinculada a un proyecto» de «sesión lanzada en el proyecto» (esta no tiene ranura). rc 1 si no está vinculada.
VSLOT=""
vinculada() {
  local s
  VSLOT=""
  [ -z "$RAIZ_ARG" ] || return 1
  s=$(nucleo_sesion_dir 2>/dev/null) && [ -d "$s" ] && [ "$(nucleo_proyecto "$s/nucleo.md")" = "$RAIZ" ] || return 1
  VSLOT=$s
}

# Modo sesión: sin proyecto y sin --raiz, el estado de este claude vive en su ranura (nucleo_sesion_dir). SES = la
# ranura, o vacío. Con --commit no aplica: la ranura no es de ningún repo (die 3 antes de escribir nada).
SES=""
sesion() {
  [ -z "$RAIZ_ARG" ] || return 1
  [ "$COMMIT" -eq 0 ] || die 3 "--commit no aplica al estado de una sesión en ~ (no hay repo): no escribo nada"
  SES=$(nucleo_sesion_dir "$@") || { SES=""; return 1; }
}

if [ "$MODO" = agentes ]; then
  resolver_raiz || sesion || die 3 "sin proyecto ni sesión"
  if [ -n "$SES" ]; then E=$SES; else E=$(nucleo_estado_leer "$RAIZ") || die 3 "estado enlazado o inseguro"; fi
  FILAS=$(nucleo_agentes_estado "$E")
  if [ -n "$FILAS" ]; then
    printf 'ID\tTIPO\tESTADO\tRESULTADO\n'
    printf '%s\n' "$FILAS" | cut -f1-4
  else echo "Sin agentes registrados."
  fi
  exit 0
fi

if [ "$MODO" = estado ]; then
  if ! resolver_raiz; then
    if sesion; then
      NUC=$SES/nucleo.md; B=0; SHA=""; [ ! -f "$NUC" ] || SHA=$(sha256sum <"$NUC" | cut -d' ' -f1); [ ! -f "$NUC" ] || B=$(wc -c <"$NUC" | tr -d ' ')
      VIVOS=$(nucleo_agentes_vivos "$SES" "$SESION" | jq length) || die 1 "registro ilegible"
      jq -cn --arg sha "$SHA" --argjson av "$VIVOS" --arg s "$SES" --arg n "$NUC" --argjson b "$B" --argjson t "$TOPE" --argjson p "$((B * 100 / TOPE))" \
        '{raiz:null,sesion:$s,nucleo:$n,bytes:$b,tope:$t,pct:$p,dueno:null,sha256:(if $sha == "" then null else $sha end),agentes_vivos:$av}'
      exit 0
    fi
    echo '{"raiz":null}'; exit 3
  fi
  if nucleo_enlazado "$RAIZ"; then echo '{"raiz":null}'; exit 3; fi
  E=$(nucleo_estado_leer "$RAIZ") || die 3 "estado enlazado o inseguro"
  NUC=$E/nucleo.md; EJ=""
  # En modo ESTADO.md el tamaño y el hash son los de ESTADO.md; «nucleo» sigue siendo la ruta de nucleo.md que no existe (los clientes la validan).
  if nucleo_modo_estado_md "$RAIZ"; then EJ=$RAIZ/ESTADO.md; fi
  B=0; SHA=""; F=${EJ:-$NUC}
  if [ -f "$F" ]; then B=$(wc -c <"$F" | tr -d ' '); SHA=$(sha256sum <"$F" | cut -d' ' -f1); fi
  DJ=null
  if D=$(nucleo_dueno "$RAIZ"); then
    V=false; ! nucleo_dueno_vigente "$RAIZ" >/dev/null || V=true
    DJ=$(jq -cn --arg s "${D% *}" --arg d "$(iso_de "${D#* }")" --argjson v "$V" '{sesion:$s,desde:$d,vigente:$v}')
  fi
  VIVOS=$(nucleo_agentes_vivos "$E" "$SESION" | jq length) || die 1 "no puedo leer la foto de agentes de $SESION"
  # Sesión de ~ vinculada a este proyecto: el estado es el del proyecto y se dice cuál es la ranura (`sesion`) y que hay vínculo.
  vinculada || true
  jq -cn --arg sha "$SHA" --argjson av "$VIVOS" --arg r "$RAIZ" --arg n "$NUC" --arg ej "$EJ" --arg vs "$VSLOT" --argjson b "$B" --argjson t "$TOPE" --argjson p "$((B * 100 / TOPE))" --argjson d "$DJ" \
    '{raiz:$r,nucleo:$n,bytes:$b,tope:$t,pct:$p,dueno:$d,agentes_vivos:$av,sha256:(if $sha == "" then null else $sha end)} + (if $ej == "" then {} else {modo:"estado-md",estado:$ej} end) + (if $vs == "" then {} else {sesion:$vs,vinculado:true} end)'
  exit 0
fi

if [ "$MODO" = liberar ]; then
  resolver_raiz || die 3 "sin proyecto"
  E=$(nucleo_estado_leer "$RAIZ") || die 3 "estado enlazado o inseguro"
  [ -d "$E" ] || die 5 "no hay dueño que coincida con $SESION"
  nucleo_bloquear "$E" || die "$?" "estado ocupado o inseguro: reintenta"
  D=$(nucleo_dueno "$RAIZ") && [ "${D% *}" = "$SESION" ] || die 5 "el dueño no coincide con $SESION"
  rm -f -- "$E/.dueno"
  echo "handoff: dueño $SESION liberado; nucleo.md conservado"
  exit 0
fi

# ---------------------------------------------------------------- --iniciar
if [ "$MODO" = iniciar ]; then
  resolver_raiz || sesion crear || die 3 "sin proyecto ni ranura de sesión (ni \$HOME, ni ~/.claude, ni un directorio sin git es proyecto): no escribo nada"
  [ -n "$SES" ] || ! nucleo_enlazado "$RAIZ" || die 3 "$RAIZ/.claude, su estado o algo dentro de él es un enlace o apunta fuera del proyecto: no escribo nada"
  if [ -z "$SES" ] && nucleo_modo_estado_md "$RAIZ"; then echo "handoff: $RAIZ/ESTADO.md es el estado del proyecto: no creo un nucleo.md en paralelo"; exit 0; fi
  PLANTILLA=${CLAUDE_HOME:-$HOME/.claude}/templates/nucleo.md
  [ -f "$PLANTILLA" ] || PLANTILLA=$(dirname "$SELF")/../templates/nucleo.md
  [ -f "$PLANTILLA" ] || die 1 "no encuentro la plantilla templates/nucleo.md (¿instalaste el kit?)"
  if [ -n "$SES" ]; then E=$SES; else E=$(nucleo_estado_dir "$RAIZ") || die 1 "no puedo escribir ni en $RAIZ/.claude/estado ni en el directorio de usuario"; fi
  nucleo_bloquear "$E" || die "$?" "estado ocupado o inseguro: reintenta"
  if [ -e "$E/nucleo.md" ]; then echo "handoff: $E/nucleo.md ya existe: no se toca"; exit 0; fi
  [ -n "$SES" ] || { D=$(nucleo_dueno_ajeno "$RAIZ" "$SESION") && die 5 "la sesión dueña es otra ($D): no inicio"; }
  cp -- "$PLANTILLA" "$E/nucleo.md"
  [ -n "$SES" ] || [ "$E" = "$RAIZ/.claude/estado" ] || : >"$E/.nucleo-fallback"
  if [ -z "$SES" ] && EX=$(git -C "$RAIZ" rev-parse --git-path info/exclude 2>/dev/null); then
    case $EX in /*) ;; *) EX=$RAIZ/$EX ;; esac
    mkdir -p "$(dirname "$EX")" 2>/dev/null || true
    command grep -qFx '.claude/estado/' "$EX" 2>/dev/null || printf '.claude/estado/\n' >>"$EX" 2>/dev/null || true
  fi
  echo "handoff: $E/nucleo.md creado desde la plantilla"
  exit 0
fi

# ---------------------------------------------------------------- --informe
if [ "$MODO" = informe ]; then
  resolver_raiz || sesion crear || die 3 "sin proyecto ni ranura de sesión (ni \$HOME, ni ~/.claude, ni un directorio sin git es proyecto): no escribo nada"
  T=${TEMA//\//-}; T=${T//../-}
  T=$(printf '%s' "$T" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-' | LC_ALL=C tr -s '-')
  T=${T#"${T%%[!.-]*}"}; T=${T%"${T##*[!.-]}"}
  [ -n "$T" ] || { echo "uso: handoff: el tema no deja nada tras sanearlo (handoff --help)" >&2; exit 64; }
  if [ -n "$SES" ]; then E=$SES; else E=$(nucleo_estado_dir "$RAIZ") || die 3 "no puedo escribir el estado de $RAIZ (¿enlaces simbólicos, o sin permiso aquí y en el directorio de usuario?)"; fi
  mkdir -p -- "$E/informes/$(date +%F)-$T" || die 1 "no puedo crear el directorio del informe"
  printf '%s\n' "$E/informes/$(date +%F)-$T"
  exit 0
fi

# ---------------------------------------------------------------- --migrar
if [ "$MODO" = migrar ]; then
  if [ -z "$MIGRAR" ]; then
    sesion || die 3 "sin ranura de sesión"
    ME=$SES
  else
    [ -d "$MIGRAR" ] || die 1 "no existe el directorio «$MIGRAR»"
    MIGRAR=$(realpath -- "$MIGRAR")
    ME=$(nucleo_estado_leer "$MIGRAR") || die 3 "estado enlazado o inseguro: no escribo nada"
  fi
  MN=$ME/nucleo.md
  if [ -d "$ME" ]; then
    nucleo_bloquear "$ME" || die "$?" "estado ocupado o inseguro: reintenta"
    [ -n "$SES" ] || { D=$(nucleo_dueno_ajeno "$MIGRAR" "$SESION") && die 5 "la sesión dueña es otra ($D): no migro"; }
  fi
  if [ ! -f "$MN" ]; then
    [ -z "$ESPERADO" ] || die 4 "el núcleo esperado ya no existe: no archivo"
    if [ "$JSON" = 1 ]; then jq -cn --arg n "$MN" '{nucleo:$n,sha256:null,archivo:null}'
    else echo "handoff: nada que migrar: no existe $MN"
    fi
    exit 0
  fi
  SHA=$(sha256sum <"$MN" | cut -d' ' -f1)
  [ -z "$ESPERADO" ] || [ "$SHA" = "$ESPERADO" ] || die 4 "nucleo.md cambió desde el guardado: no archivo"

  [ -n "$SES" ] || [ "$ME" = "$MIGRAR/.claude/estado" ] || : >"$ME/.nucleo-fallback"
  mkdir -p "$ME/archivo"
  AR=$ME/archivo/nucleo-$(date -u +%Y%m%dT%H%M%SZ).md
  [ ! -e "$AR" ] || AR=${AR%.md}-$$.md
  mv -n -- "$MN" "$AR"
  [ ! -e "$MN" ] || die 4 "el destino de archivo ya existe: núcleo conservado"
  printf -- '- %s · nucleo heredado archivado en archivo/%s\n' "$(date -u +%F)" "${AR##*/}" >>"$ME/diario.md"
  if [ "$JSON" = 1 ]; then jq -cn --arg n "$MN" --arg s "$SHA" --arg a "$AR" '{nucleo:$n,sha256:$s,archivo:$a}'
  else echo "handoff: $MN archivado en $AR"
  fi
  exit 0
fi

# ---------------------------------------------------------------- --auto
# Guardado sin modelo desde un hook (autosave.sh): solo la sección «## Último turno (auto)», con las cuatro reglas del
# ADR 028: solo esa sección, mismo lock y mv atómico (ocupado: no espera), sin rotar nucleo.prev-* y sin tocar el dueño.
if [ "$MODO" = auto ]; then
  AUTOH="## Último turno (auto)"
  AUTO_TOPE=600
  AIN=""; [ -t 0 ] || AIN=$(head -c 4194304 2>/dev/null || true)
  # a_json <filtro>: un campo del JSON del hook (vacío si no hay JSON o no es válido).
  a_json() { [ -n "$AIN" ] || return 0; jq -r "$1 // empty" <<<"$AIN" 2>/dev/null || true; }
  # a_ruta <ruta>: solo absolutas, sin «..» ni controles (ADR 027): lo que viene del JSON del hook no es de fiar.
  a_ruta() { case $1 in /* ) ;; *) return 1 ;; esac; case $1 in *[[:cntrl:]]* | */../* | */..) return 1 ;; esac; }
  EV=$(a_json .hook_event_name); CWDJ=$(a_json .cwd); TP=$(a_json .transcript_path)
  [ -n "$SESION" ] || SESION=$(a_json .session_id)
  [ -n "$SESION" ] || SESION=${CLAUDE_CODE_SESSION_ID:-}
  [ -z "$TRANSCRIPT_ARG" ] || TP=$TRANSCRIPT_ARG
  if [ -z "$MOTIVO" ]; then case $EV in PostCompact) MOTIVO=compact ;; SessionEnd) MOTIVO=fin ;; *) MOTIVO=stop ;; esac; fi
  case $SESION in *[!A-Za-z0-9_-]*) SESION="" ;; esac
  CWDJ=${CWDJ%/}
  ALOG=${CLAUDE_HOME:-$HOME/.claude}/session-logs/autosave.log
  # a_omitir <motivo>: nada que hacer (rc 0), sin escribir nada.
  a_omitir() {
    # Todo turno saltado queda anotado: un guardado que no ocurre sin dejar rastro es indistinguible de uno roto.
    if mkdir -p "$(dirname "$ALOG")" 2>/dev/null; then
      printf '%s\t%s\t%s\t0\t0\tomitido=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${SESION:--}" "$MOTIVO" "$1" >>"$ALOG" 2>/dev/null || true
    fi
    if [ "$JSON" = 1 ]; then jq -cn --arg o "$1" '{omitido:$o}'; else echo "handoff: --auto omitido: $1"; fi
    exit 0
  }
  [ -z "$CWDJ" ] || { a_ruta "$CWDJ" && [ -d "$CWDJ" ]; } || a_omitir "cwd inválido"
  AES=""; AINI=0
  if [ -n "$RAIZ_ARG" ]; then resolver_raiz || RAIZ=""
  elif [ -n "$CWDJ" ]; then RAIZ=$(nucleo_raiz "$CWDJ") || RAIZ=""
  else resolver_raiz || RAIZ=""
  fi
  if [ -z "$RAIZ" ]; then
    # Sin proyecto: el estado de esta sesión es su ranura de ~. Ya existente o, si hay trabajo que anotar, nueva (más abajo).
    [ -z "$RAIZ_ARG" ] || a_omitir "sin estado"
    AES=$(nucleo_sesion_dir 2>/dev/null) || a_omitir "sin estado"
    RAIZ=$HOME
  else
    nucleo_enlazado "$RAIZ" && a_omitir "estado enlazado"
    ! nucleo_modo_estado_md "$RAIZ" || a_omitir "modo ESTADO.md"
    AE=$(nucleo_estado_leer "$RAIZ") || a_omitir "sin estado"
    # Repo sin estado: el primer guardado con trabajo lo crea desde la plantilla (NUCLEO_AUTOINICIO=0 lo apaga).
    [ -f "$AE/nucleo.md" ] || { [ "${NUCLEO_AUTOINICIO:-1}" != 0 ] || a_omitir "sin estado"; AINI=1; }
  fi

  # El transcript solo vale si es un fichero normal bajo ~ o bajo la raíz del proyecto (ADR 027).
  case $TP in "$HOME"/* | "$RAIZ"/*) a_ruta "$TP" && [ -f "$TP" ] && [ -r "$TP" ] || TP="" ;; *) TP="" ;; esac

  # ---- captura: transcript (últimas líneas) y git; todo se recorta y pierde < y > para que no cierre el <nucleo-datos> al emitirse
  APERSONA=""; AASIST=""; AFILES=(); ACMDS=()
  if [ -n "$TP" ]; then
    AJ=$(tail -c 1000000 "$TP" 2>/dev/null | tail -n 600 | jq -R -n -c '
      def limpia: gsub("[\u0000-\u001f\u007f]+"; " ") | gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "");
      def sin_ang: gsub("[<>]"; "");
      def texto: if type == "array" then map(objects | select(.type == "text") | .text) | join(" ") else . end;
      [inputs | fromjson? | select(type == "object")] as $l
      | ($l[-300:] | map(select(.type == "assistant") | .message.content | arrays[] | objects | select(.type == "tool_use"))) as $tu
      | {persona: ([$l[] | select(.type == "user" and ((.isMeta // false) | not)) | (.message | objects | .content) | texto
                    | select(type == "string") | limpia | select(startswith("<") | not) | select(. != "")] | last // "" | sin_ang),
         asist: ([$l[] | select(.type == "assistant") | (.message | objects | .content) | texto | select(type == "string") | limpia | select(. != "")] | last // "" | sin_ang),
         files: [$tu[] | select(.name | IN("Edit", "Write", "NotebookEdit", "MultiEdit")) | (.input.file_path // .input.notebook_path) | strings],
         cmds: [$tu[] | select(.name == "Bash") | .input.command | strings]}' 2>/dev/null) || AJ=""
    if [ -n "$AJ" ]; then
      APERSONA=$(jq -r '.persona' <<<"$AJ" 2>/dev/null) || APERSONA=""
      AASIST=$(jq -r '.asist' <<<"$AJ" 2>/dev/null) || AASIST=""
      mapfile -t AFILES < <(jq -r '.files | reverse[]' <<<"$AJ" 2>/dev/null)
      mapfile -t ACMDS < <(jq -r '.cmds | .[-3:] | reverse[] | split("\n")[0] | gsub("[\u0000-\u001f\u007f<>]"; " ")' <<<"$AJ" 2>/dev/null)
    fi
  fi
  ALM=$(a_json .last_assistant_message | tr -s '[:space:]' ' ' | tr -d '<>' | LC_ALL=C tr -d '\000-\010\013-\037\177')
  [ -z "${ALM// /}" ] || AASIST=$ALM
  # Se redacta ANTES de cortar (una clave partida por el corte quedaría a medias). Mismas reglas que `redact` del
  # cockpit (kit/mods/cockpit/hooks/register.tsx); es un respaldo, no un escáner de secretos.
  # shellcheck disable=SC2016  # el programa jq lleva $t y $n, no son de bash
  AUTOCORTA() { jq -rn --arg t "$1" --argjson n "$2" '
    def r: "[REDACTADO]";
    $t
    | gsub("\\bsk-[A-Za-z0-9_-]{16,}"; r)
    | gsub("\\bgh[pousr]_[A-Za-z0-9]{20,}"; r)
    | gsub("\\bAKIA[0-9A-Z]{16}\\b"; r)
    | gsub("\\bxox[abprs]-[A-Za-z0-9-]{10,}"; r)
    | gsub("\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"; r)
    | gsub("\\bgithub_pat_[A-Za-z0-9_]{20,}"; r)
    | gsub("\\bglpat-[A-Za-z0-9_-]{16,}"; r)
    | gsub("-----BEGIN [A-Z ]*PRIVATE KEY-----(.|\n)*?(-----END [A-Z ]*PRIVATE KEY-----|$)"; r)
    | gsub("(?<e>\\b[a-z][a-z0-9+.-]*://)[^\\s/@:]+:[^\\s/@]+@"; "\(.e)[REDACTADO]@"; "i")
    | gsub("\\bBearer\\s+\\S+"; "Bearer [REDACTADO]"; "i")
    | gsub("(?<k>\\b(password|passwd|pwd|secret|token|api[_-]?key)[\"\\x27]?\\s*[:=]\\s*)(?!\\[REDACTADO\\])(\"[^\"]*\"|\\x27[^\\x27]*\\x27|\\S+)"; "\(.k)[REDACTADO]"; "i")
    | sub("^ +"; "") | sub(" +$"; "") | .[0:$n]'; }
  # Tocados: del transcript (lo más reciente primero) y de git; rutas relativas a la raíz, sin duplicados, ni .claude/estado/.
  declare -A VISTO=()
  ATOC=(); ASHA=""; ARAMA=""
  atoc_add() {
    local f=$1
    case $f in "$RAIZ"/*) f=${f#"$RAIZ"/} ;; esac
    f=${f//[<>]/}
    case $f in .claude/estado/* | "" | *[[:cntrl:]]*) return 0 ;; esac
    [ -z "${VISTO[$f]+x}" ] || return 0
    VISTO[$f]=1; ATOC+=("$f")
  }
  for f in ${AFILES[@]+"${AFILES[@]}"}; do atoc_add "$f"; done
  if [ "$RAIZ" != "$HOME" ] && command -v git >/dev/null 2>&1; then
    ASHA=$(timeout 3 git -c core.fsmonitor=false -C "$RAIZ" rev-parse HEAD 2>/dev/null) || ASHA=""
    ARAMA=$(timeout 3 git -c core.fsmonitor=false -C "$RAIZ" branch --show-current 2>/dev/null) || ARAMA=""
    while IFS= read -r f; do atoc_add "$f"; done < <(
      { timeout 3 git -c core.fsmonitor=false -C "$RAIZ" diff --name-only HEAD 2>/dev/null || true
        timeout 3 git -c core.fsmonitor=false -C "$RAIZ" ls-files --others --exclude-standard 2>/dev/null; } | head -n 200)
  fi
  ATOCN=${#ATOC[@]}
  ACMDN=${#ACMDS[@]}

  # Sin trabajo que anotar, una ranura nueva de ~ no se crea (y no se anota nada en una sesión sin nada).
  if { [ -n "$AES" ] && [ ! -f "$AES/nucleo.md" ]; } || [ "$AINI" -eq 1 ]; then
    [ "$ATOCN" -gt 0 ] || [ "$ACMDN" -gt 0 ] || a_omitir "sin trabajo"
  fi
  if [ "$RAIZ" = "$HOME" ]; then
    [ -d "$AES" ] || AES=$(nucleo_sesion_dir crear 2>/dev/null) || a_omitir "sin ranura"
    E=$AES; NUC=$E/nucleo.md
  else
    E=$(nucleo_estado_dir "$RAIZ" 2>/dev/null) || a_omitir "estado no escribible"
    NUC=$E/nucleo.md; [ -f "$NUC" ] || [ "$AINI" -eq 1 ] || a_omitir "sin estado"
  fi
  nucleo_bloquear "$E" 2>/dev/null || a_omitir "ocupado"
  if [ "$RAIZ" != "$HOME" ]; then
    nucleo_dueno_ajeno "$RAIZ" "$SESION" >/dev/null && a_omitir "dueño ajeno"
    # La primera escritura de una sesión sin dueño vigente la hace dueña (quien arrancó antes de que hubiera estado).
    [ -z "$SESION" ] || { D=$(nucleo_dueno_vigente "$RAIZ") && [ "${D% *}" = "$SESION" ]; } || nucleo_dueno_tomar "$RAIZ" "$E" "$SESION" 2>/dev/null || true
  fi

  if [ "$AINI" -eq 1 ] && [ ! -f "$NUC" ]; then
    APLANT=${CLAUDE_HOME:-$HOME/.claude}/templates/nucleo.md
    [ -f "$APLANT" ] || APLANT=$(dirname "$SELF")/../templates/nucleo.md
    [ -f "$APLANT" ] || a_omitir "sin plantilla"
    cp -- "$APLANT" "$NUC" 2>/dev/null || a_omitir "estado no escribible"
    [ "$E" = "$RAIZ/.claude/estado" ] || : >"$E/.nucleo-fallback"
    if AEX=$(git -C "$RAIZ" rev-parse --git-path info/exclude 2>/dev/null); then
      case $AEX in /*) ;; *) AEX=$RAIZ/$AEX ;; esac
      mkdir -p "$(dirname "$AEX")" 2>/dev/null || true
      command grep -qFx '.claude/estado/' "$AEX" 2>/dev/null || printf '.claude/estado/\n' >>"$AEX" 2>/dev/null || true
    fi
  fi

  # ---- la sección
  ATS=$(date +%Y-%m-%dT%H:%M)
  AL1="- $ATS · $MOTIVO"
  [ -z "$ARAMA" ] || AL1+=" · rama ${ARAMA//[<>[:cntrl:]]/} @ ${ASHA:0:7}"
  if [ -n "$TP" ]; then ACTX=$(nucleo_ctx "$TP" 2>/dev/null | cut -d' ' -f2); [ -z "$ACTX" ] || AL1+=" · ctx $ACTX %"; fi
  ASEC=$AUTOH$'\n'"$AL1"$'\n'
  [ -z "$APERSONA" ] || ASEC+="- Persona: «$(AUTOCORTA "$APERSONA" 120)»"$'\n'
  [ -z "$AASIST" ] || ASEC+="- Asistente: «$(AUTOCORTA "$AASIST" 160)»"$'\n'
  if [ "$ATOCN" -gt 0 ]; then
    AT=""; for ((i = 0; i < ATOCN && i < 4; i++)); do AT+="${AT:+, }$(AUTOCORTA "${ATOC[i]}" 60)"; done
    [ "$ATOCN" -le 4 ] || AT+=" +$((ATOCN - 4))"
    ASEC+="- Tocados: $AT"$'\n'
  fi
  if [ "$ACMDN" -gt 0 ]; then
    AC=""
    for c in "${ACMDS[@]}"; do
      c=$(AUTOCORTA "$c" 50); rc=""; b=${c#oraculo -- }
      if [ -f "$E/verificaciones.log" ]; then rc=$(awk -F'\t' -v c="$b" '$3 == c { r = $2 } END { if (r ~ /^[0-9]+$/) print r }' "$E/verificaciones.log" 2>/dev/null) || rc=""; fi
      AC+="${AC:+ · }$c${rc:+ rc $rc}"
    done
    ASEC+="- Comandos: $AC"$'\n'
  fi
  # Tope de la sección: se quitan líneas desde el final (mínimo, la primera).
  while [ "$(bytes "$ASEC")" -gt "$AUTO_TOPE" ] && [ "$(printf '%s' "$ASEC" | wc -l)" -gt 2 ]; do ASEC=${ASEC%$'\n'*$'\n'}$'\n'; done

  # ---- el nucleo sin su sección auto + la nueva; si pasa del tope se recorta solo la sección auto, hasta
  # dos líneas. Sin sitio ni para eso se escribe igual: omitirla dejaba la vieja, que tras compactar engaña;
  # los bytes de más los recortan la inyección (el auto sale el primero) y el siguiente --desde.
  AW=$(mktemp -d "${TMPDIR:-/tmp}/handoff.XXXXXX") || a_omitir "sin temporal"
  TMP=""
  trap 'rm -rf -- "$AW"; [ -z "$TMP" ] || rm -f -- "$TMP"' EXIT
  ACK=$(cksum <"$NUC" 2>/dev/null) || ACK=""
  if [ -f "$NUC" ]; then
    AVIEJA=$(awk -v h="$AUTOH" '/^[ \t]*(```|~~~)/ { c = !c } !c && /^## / { g = ($0 == h) } !g { print }' "$NUC")
    ABASE=$(sed -n 's/^<!-- git:\([0-9a-f]\{7,40\}\) -->$/\1/p' "$NUC" | head -n 1)
  else AVIEJA="# Estado"; ABASE=""
  fi
  # $(…) se come los saltos finales: queda el del último renglón y una línea en blanco antes de la sección; el resto no cambia.
  ARES=$AVIEJA$'\n\n'
  ANUEVO=$ARES$ASEC
  while [ "$(bytes "$ANUEVO")" -gt "$TOPE" ] && [ "$(printf '%s' "$ASEC" | wc -l)" -gt 2 ]; do
    ASEC=${ASEC%$'\n'*$'\n'}$'\n'; ANUEVO=$ARES$ASEC
  done

  # ---- dirty: ¿hay trabajo sin sintetizar?
  ADIRTY=$E/autosave.dirty; ANOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  AMOT=""; ADES=$ANOW
  if [ -f "$ADIRTY" ] && [ ! -L "$ADIRTY" ]; then
    while IFS='=' read -r k v; do case $k in motivo) AMOT=$v ;; desde) ADES=$v ;; esac; done <"$ADIRTY"
    case $AMOT in edit | compact) ;; *) AMOT="" ;; esac
    case $ADES in *[!0-9A-Za-z:-]*) ADES=$ANOW ;; esac
  fi
  ANUEVOC=0; [ -z "$ABASE" ] || [ -z "$ASHA" ] || [ "$ASHA" = "$ABASE" ] || [[ $ASHA == "$ABASE"* ]] || ANUEVOC=1
  if [ "$MOTIVO" = compact ]; then AMOT=compact
  elif [ "$ATOCN" -gt 0 ] || [ "$ANUEVOC" -eq 1 ]; then AMOT=${AMOT:-edit}
  fi

  # ---- escritura: temporal junto al nucleo, mtime y modo del anterior, mv atómico
  TMP=$(mktemp "$E/.nucleo.XXXXXX") || a_omitir "sin temporal"
  printf '%s' "$ANUEVO" >"$TMP"
  [ -z "${NUCLEO_FUSION_PAUSA:-}" ] || sleep "$NUCLEO_FUSION_PAUSA"
  # El Stop es asíncrono y el turno siguiente edita: si el nucleo cambió desde la lectura, el mv lo pisaría.
  [ "$(cksum <"$NUC" 2>/dev/null)" = "$ACK" ] || a_omitir "nucleo cambió"
  if [ -f "$NUC" ]; then touch -r "$NUC" "$TMP" 2>/dev/null || true; chmod "$(stat -c %a "$NUC" 2>/dev/null || stat -f %Lp "$NUC")" "$TMP" 2>/dev/null || true; fi
  mv -f -- "$TMP" "$NUC"; TMP=""
  if [ -n "$AMOT" ]; then
    printf 'motivo=%s\ndesde=%s\nultimo=%s\n' "$AMOT" "$ADES" "$ANOW" >"$AW/dirty" && mv -f -- "$AW/dirty" "$ADIRTY" 2>/dev/null || true
  fi
  # Se reescribe si cambió: un /resume dentro del mismo proceso cambia el session_id y por_sid busca por igualdad.
  if [ -n "$AES" ] && [ -n "$SESION" ] && [ "$(cat "$AES/.sesion" 2>/dev/null)" != "$SESION" ]; then printf '%s\n' "$SESION" >"$AES/.sesion" 2>/dev/null || true; fi
  # Lo mismo en una ranura vinculada: el estado va al proyecto, pero un `claude --resume` la busca por el session_id.
  if [ -z "$AES" ] && [ -n "$SESION" ] && vinculada && [ "$(cat "$VSLOT/.sesion" 2>/dev/null)" != "$SESION" ]; then printf '%s\n' "$SESION" >"$VSLOT/.sesion" 2>/dev/null || true; fi
  if [ "$MOTIVO" = compact ] && [ -n "$SESION" ]; then
    a_json .compact_summary | head -c 4096 >"$AW/resumen"
    if [ -s "$AW/resumen" ]; then
      mkdir -p "$E/checkpoints" 2>/dev/null && ( umask 077; cat "$AW/resumen" >"$E/checkpoints/compact-summary-$(printf '%s' "$SESION" | sha256sum | cut -d' ' -f1).md" ) 2>/dev/null || true
      find "$E/checkpoints" -maxdepth 1 -type f -name 'compact-summary-*.md' -mtime +14 -delete 2>/dev/null || true
    fi
  fi
  # Log: una línea por guardado, a 1000 al pasar de 2000.
  if mkdir -p "$(dirname "$ALOG")" 2>/dev/null; then
    printf '%s\t%s\t%s\t%s\t0\n' "$ANOW" "${SESION:--}" "$MOTIVO" "$(bytes "$ASEC")" >>"$ALOG" 2>/dev/null || true
    if [ "$(wc -l <"$ALOG" 2>/dev/null || echo 0)" -gt 2000 ]; then
      tail -n 1000 "$ALOG" >"$AW/log" 2>/dev/null && mv -f -- "$AW/log" "$ALOG" 2>/dev/null || true
    fi
  fi
  if [ "$JSON" = 1 ]; then
    jq -cn --arg n "$NUC" --arg s "$(printf '%s' "$ANUEVO" | sha256sum | cut -d' ' -f1)" --arg m "$MOTIVO" --argjson b "$(bytes "$ASEC")" '{nucleo:$n,sha256:$s,bytes:$b,motivo:$m}'
  else echo "handoff: sección auto escrita en $NUC ($(bytes "$ASEC") B)"
  fi
  exit 0
fi

# ---------------------------------------------------------------- --desde
# ranura_propia: SES = la ranura que da --ranura, si es de esta sesión; si no, sale sin escribir nada.
ranura_propia() {
  local f
  # El destino explícito solo vale dentro de sesiones/: realpath resuelve «..» y enlaces antes de comparar.
  RBASE=$(realpath -- "${CLAUDE_HOME:-$HOME/.claude}/estado/sesiones" 2>/dev/null) || die 1 "--ranura: no existe ${CLAUDE_HOME:-$HOME/.claude}/estado/sesiones"
  SES=$(realpath -- "$RANURA_ARG" 2>/dev/null) && [ -d "$SES" ] && [ "$(dirname "$SES")" = "$RBASE" ] || die 1 "--ranura «$RANURA_ARG» no es una ranura dentro de $RBASE: no escribo nada"
  for f in "$SES"/* "$SES"/.[!.]*; do [ ! -L "$f" ] || die 1 "--ranura: hay un enlace simbólico dentro de $SES: no escribo nada"; done
  # Y solo la propia: nucleo_sesion_dir la ata al proceso (.proceso), como cuando se llega sin --ranura.
  MIA=$(nucleo_sesion_dir 2>/dev/null) || MIA=""
  [ -n "$MIA" ] && [ "$(realpath -- "$MIA" 2>/dev/null)" = "$SES" ] ||
    die 5 "--ranura «$RANURA_ARG» es de otra sesión${MIA:+; la tuya es $MIA}: no escribo nada"
}

# ---------------------------------------------------------------- --proyecto
# Vincula la ranura de esta sesión de ~ con un proyecto (D3 de 2.1.0): desde aquí el estado de trabajo vive en
# <proyecto>/.claude/estado/ y la ranura queda como coordinación. Bajo el lock de la ranura y el del proyecto; todo lo que
# puede rechazarse (ruta, dueño ajeno) se mira antes de escribir nada.
if [ "$MODO" = proyecto ]; then
  [ -n "$SESION" ] || die 64 "--proyecto necesita --sesion ID (o CLAUDE_CODE_SESSION_ID): el dueño del proyecto es una sesión"
  case $SESION in *[!A-Za-z0-9_-]*) die 64 "--sesion: solo letras, cifras, «_» y «-»" ;; esac
  if [ -n "$RANURA_ARG" ]; then ranura_propia
  else
    # La ranura es lo único que dice que la sesión es de ~: una lanzada en un proyecto ya tiene el suyo.
    [ -z "${CLAUDE_PROJECT_DIR:-}" ] || ! NUCLEO_VINCULO=0 nucleo_raiz "$CLAUDE_PROJECT_DIR" >/dev/null || die 3 "esta sesión ya tiene proyecto ($CLAUDE_PROJECT_DIR): --proyecto es solo para sesiones lanzadas en ~"
    SES=$(nucleo_sesion_dir crear 2>/dev/null) || die 3 "sin ranura de sesión (¿no es de ~, o no se sabe su pid? pásala con --ranura): no escribo nada"
  fi
  [ -d "$PROYECTO_ARG" ] || die 3 "--proyecto: «$PROYECTO_ARG» no es un directorio: no escribo nada"
  P=$(timeout -k 1 3 git -C "$PROYECTO_ARG" rev-parse --show-toplevel 2>/dev/null) || die 3 "--proyecto: «$PROYECTO_ARG» no está dentro de un repo git: no escribo nada"
  nucleo_proyecto_valido "$P" || die 3 "--proyecto: «$P» no es un proyecto válido (ruta absoluta simple, raíz de su repo git, y ni ~ ni ~/.claude): no escribo nada"
  ! nucleo_enlazado "$P" || die 3 "$P/.claude, su estado o algo dentro de él es un enlace o apunta fuera del proyecto: no escribo nada"
  if D=$(nucleo_dueno_ajeno "$P" "$SESION"); then
    die 5 "la sesión dueña es otra ($D): no escribo. Si está abandonada: handoff --liberar $D; si no, trabaja en otra carpeta"
  fi
  SN=$SES/nucleo.md
  [ ! -L "$SN" ] || die 3 "el nucleo de la ranura es un enlace: no escribo nada"
  ACT=$(nucleo_proyecto "$SN") || ACT=""
  nucleo_bloquear "$SES" || die "$?" "ranura ocupada o insegura: reintenta"
  E=$(nucleo_estado_dir "$P") || die 3 "no puedo escribir el estado de $P (sin permiso aquí y en el directorio de usuario)"
  nucleo_bloquear "$E" || die "$?" "estado de $P ocupado o inseguro: reintenta"
  RC=0; nucleo_dueno_tomar "$P" "$E" "$SESION" || RC=$?
  case $RC in
    0) ;;
    5) die 5 "la sesión dueña es otra: no escribo. Si está abandonada: handoff --liberar <id>; si no, trabaja en otra carpeta" ;;
    *) die 1 "no puedo reclamar el dueño de $P" ;;
  esac
  W=$(mktemp -d "${TMPDIR:-/tmp}/handoff.XXXXXX")
  TMP=""
  trap 'rm -rf -- "$W"; [ -z "$TMP" ] || rm -f -- "$TMP"' EXIT
  HECHO=ya-vinculada
  if [ "$ACT" != "$P" ]; then
    HECHO=vinculada
    # El nucleo de la ranura (si no es ya solo coordinación) no se pierde ni se fusiona solo: siembra un proyecto sin estado
    # y se archiva en el diario de la ranura si el proyecto ya tiene el suyo.
    if [ -f "$SN" ] && ! command grep -qx '## Coordinación' "$SN"; then
      if [ -f "$E/nucleo.md" ] || nucleo_modo_estado_md "$P"; then
        # shellcheck disable=SC2094  # diario.md solo se añade; lo que se lee es el nucleo de la ranura
        { [ -s "$SES/diario.md" ] || printf '# Diario\n'
          printf '## %s nucleo de la ranura, archivado al vincular con %s\n' "$(date -u +%F)" "$P"; cat -- "$SN"; } >>"$SES/diario.md"
        HECHO=vinculada-y-archivada
      else
        TMP=$(mktemp "$E/.nucleo.XXXXXX") || die 1 "no puedo escribir el estado de $P"
        awk '/^## / { h = 1 } !h && /^> (sesión anterior|carpeta de trabajo|proyecto): / { next } { print }' "$SN" >"$TMP"
        mv -f -- "$TMP" "$E/nucleo.md"; TMP=""
        [ "$E" = "$P/.claude/estado" ] || : >"$E/.nucleo-fallback"
        HECHO=vinculada-y-sembrada
      fi
    fi
    if EX=$(git -C "$P" rev-parse --git-path info/exclude 2>/dev/null); then
      case $EX in /*) ;; *) EX=$P/$EX ;; esac
      mkdir -p "$(dirname "$EX")" 2>/dev/null || true
      command grep -qFx '.claude/estado/' "$EX" 2>/dev/null || printf '.claude/estado/\n' >>"$EX" 2>/dev/null || true
    fi
    # La ranura queda como coordinación: título, sesión anterior, vínculo y una línea por vínculo (las 10 últimas).
    TIT=$(sed -n 's/^\(# .*\)$/\1/p;/^## /q' "$SN" 2>/dev/null | head -n 1) || TIT=""; TIT=${TIT:-# Estado}
    TMP=$(mktemp "$SES/.nucleo.XXXXXX") || die 1 "no puedo escribir la ranura"
    {
      printf '%s\n' "$TIT"
      [ ! -f "$SN" ] || awk '/^## / { exit } /^> sesión anterior: / { print; exit }' "$SN"
      printf '> proyecto: %s\n\n## Coordinación\n' "$P"
      [ ! -f "$SN" ] || awk '/^## Coordinación$/ { c = 1; next } /^## / { c = 0 } c && /^- /' "$SN" | tail -n 9
      printf -- '- %s · %s\n' "$(date -u +%F)" "$P"
    } >"$TMP"
    mv -f -- "$TMP" "$SN"; TMP=""
  fi
  printf '%s\n' "$SESION" >"$SES/.sesion" 2>/dev/null || true
  # El registro de agentes pasa al estado del proyecto: desde ahora los hooks escriben allí.
  if [ -f "$SES/agentes.jsonl" ] && [ ! -L "$SES/agentes.jsonl" ]; then
    while IFS= read -r l || [ -n "$l" ]; do nucleo_agentes_anotar "$E" "$l" || true; done <"$SES/agentes.jsonl"
    rm -f -- "$SES/agentes.jsonl"
  fi
  for f in "$SES"/agentes-vivos-*.json; do [ -f "$f" ] && [ ! -L "$f" ] && mv -f -- "$f" "$E/" || true; done
  # Revincular: el dueño del proyecto anterior se suelta (solo si era esta sesión).
  if [ -n "$ACT" ] && [ "$ACT" != "$P" ] && AD=$(nucleo_dueno "$ACT") && [ "${AD% *}" = "$SESION" ] && AE=$(nucleo_estado_leer "$ACT"); then
    rm -f -- "$AE/.dueno"
  fi
  if [ "$JSON" = 1 ]; then jq -cn --arg r "$P" --arg n "$E/nucleo.md" --arg s "$SES" --arg h "$HECHO" '{raiz:$r,nucleo:$n,sesion:$s,resultado:$h}'
  else echo "handoff: sesión vinculada a $P: su estado vive en $E/nucleo.md ($HECHO); la ranura $SES solo coordina"
  fi
  exit 0
fi

[ -f "$DESDE" ] && [ -r "$DESDE" ] || die 2 "no puedo leer el borrador «$DESDE»"
[ "$(wc -c <"$DESDE")" -le 262144 ] || die 2 "el borrador pasa de 256 KB: un estado no es un volcado"
if [ -n "$RANURA_ARG" ]; then
  ranura_propia
  # Con la ranura vinculada a un proyecto el estado de trabajo es el del proyecto (D2): se escribe allí, desde cualquier cwd.
  if P=$(nucleo_proyecto "$SES/nucleo.md"); then RAIZ=$P; VSLOT=$SES; SES=""; fi
else
  resolver_raiz || sesion crear || die 3 "sin proyecto ni ranura de sesión (ni \$HOME, ni ~/.claude, ni un directorio sin git es proyecto): no escribo nada"
  [ -n "$SES" ] || vinculada || true
fi
# ESTMD=1: el estado del proyecto es ESTADO.md (sin nucleo.md propio): se fusiona en él y no se crea un nucleo.md en paralelo.
ESTMD=0; [ -n "$SES" ] || ! nucleo_modo_estado_md "$RAIZ" || ESTMD=1
[ "$ESTMD" -eq 0 ] || [ "$SOLO" -eq 0 ] || die 64 "--solo no aplica con ESTADO.md como estado: el borrador se fusiona, no lo sustituye"
if [ -n "$SES" ]; then E=$SES; ORIGEN=$E/nucleo.md
else
  nucleo_enlazado "$RAIZ" && die 3 "$RAIZ/.claude, su estado o algo dentro de él es un enlace o apunta fuera del proyecto: no escribo nada"
  ORIGEN=$(nucleo_estado_leer "$RAIZ")/nucleo.md || die 3 "estado inseguro"
  E=$(nucleo_estado_dir "$RAIZ") || die 3 "no puedo escribir el estado de $RAIZ (sin permiso aquí y en el directorio de usuario)"
fi
nucleo_bloquear "$E" || die "$?" "estado ocupado o inseguro: reintenta"
if [ -z "$SES" ] && D=$(nucleo_dueno_ajeno "$RAIZ" "$SESION"); then
  MIA=$(nucleo_sesion_dir 2>/dev/null) || MIA=""
  [ -z "$MIA" ] || die 5 "la sesión dueña es otra ($D): estás en un proyecto de otra sesión (si está abandonada: handoff --liberar $D); tu ranura es $MIA: handoff --desde $DESDE --sesion ${SESION:-<id>} --ranura $MIA"
  die 5 "la sesión dueña es otra ($D): no escribo. Si está abandonada: handoff --liberar $D; si no, trabaja en otra carpeta"
fi
NUC=$E/nucleo.md; DIARIO=$E/diario.md; VLOG=$E/verificaciones.log
HOY=$(date -u +%F)
# La sesión nueva tras /clear no sabe dónde quedó el transcript de esta: se lo deja el nucleo. El ID entra en un glob: solo [A-Za-z0-9-].
TRANSCRIPT=""
case $SESION in
  '' | *[!A-Za-z0-9-]*) ;;
  *) for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$SESION".jsonl; do [ ! -f "$f" ] || TRANSCRIPT=$f; break; done ;;
esac
# La carpeta donde trabajaba la sesión (su cwd vivo) viaja igual: /clear la devuelve a donde arrancó y la sesión nueva no sabe dónde estaba.
# Solo si difiere de ese punto de arranque (CLAUDE_PROJECT_DIR si existe; si no, ~ en una ranura y la raíz del proyecto). Ruta absoluta, de un
# directorio, sin controles y de ≤ 400 chars: va dentro de una línea que el hook de SessionStart lee como dato.
CARPETA=""
if [[ $PWD == /* && $PWD != *[[:cntrl:]]* ]] && [ "${#PWD}" -le 400 ] && [ -d "$PWD" ]; then
  INICIO=${CLAUDE_PROJECT_DIR:-${SES:+$HOME}${VSLOT:+$HOME}}; INICIO=${INICIO:-$RAIZ}
  [ "${PWD%/}" = "${INICIO%/}" ] || CARPETA=$PWD
fi
# YA: los cierres que diario.md ya tiene, sin fecha ni hash. El borrador de cada handoff suele traer otra vez los [x] ya cerrados.
YA=$'\n'; [ ! -f "$DIARIO" ] || YA+=$(sed -n 's/^- [0-9-]* · \(.*\) · [^ ]*$/\1/p' "$DIARIO")$'\n'

W=$(mktemp -d "${TMPDIR:-/tmp}/handoff.XXXXXX")
TMP=""
trap 'rm -rf -- "$W"; [ -z "$TMP" ] || rm -f -- "$TMP"' EXIT

# norm <título>: NORM = minúsculas, sin acentos y con espacios simples (también con mayúsculas acentuadas en LC_ALL=C).
norm() {
  local t=${1,,}
  t=${t//á/a}; t=${t//é/e}; t=${t//í/i}; t=${t//ó/o}; t=${t//ú/u}; t=${t//ü/u}; t=${t//ñ/n}
  t=${t//Á/a}; t=${t//É/e}; t=${t//Í/i}; t=${t//Ó/o}; t=${t//Ú/u}; t=${t//Ü/u}; t=${t//Ñ/n}
  t=${t//$'\t'/ }
  while [[ $t == *"  "* ]]; do t=${t//  / }; done
  t=${t# }; NORM=${t% }
}
# clave <título>: KEY = clave de la sección; Objetivo/Encargo original y Invariantes son familias por prefijo
# (como la tabla que hoy tiene el mod cockpit); «Pendientes y riesgos» es un alias de «pendientes».
clave() {
  norm "$1"
  case $NORM in
    objetivo* | "encargo original"*) KEY=objetivo ;;
    invariantes*) KEY=invariantes ;;
    "pendientes y riesgos") KEY=pendientes ;;
    "como se comprueba") [ "${ESTMD:-0}" -eq 1 ] && KEY="comandos de verificacion" || KEY=$NORM ;;
    *) KEY=$NORM ;;
  esac
}
admitida() {
  case $1 in
    decisiones) [ "${ESTMD:-0}" -eq 1 ] && return 0 ;;
    objetivo | invariantes | "paso actual" | "siguiente accion" | "comandos de verificacion" | plan | pendientes | "ficheros tocados") return 0 ;;
  esac
  return 1
}
# titulo_de <título>: el título con el que se escribe (el alias vuelve a su nombre de plantilla).
titulo_de() { norm "$1"; if [ "$NORM" = "pendientes y riesgos" ]; then TITULO=Pendientes; else TITULO=$1; fi; }
# fin_nl <variable>: asegura el salto de línea final (no vale $(…), que se los come).
fin_nl() { local -n r=$1; case $r in *$'\n') ;; *) r+=$'\n' ;; esac; }

# parsear <fichero>: PHEAD (lo anterior a la primera «## »), PK[] claves, PTIT[] títulos, PT[] texto con su
# cabecera y salto final. Una «## » dentro de una cerca ``` o ~~~ es contenido.
parsear() {
  local line cerca=0 i=-1
  PHEAD=""; PK=(); PTIT=(); PT=()
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    if [[ $line =~ ^[[:space:]]*(\`\`\`|~~~) ]]; then cerca=$((1 - cerca)); fi
    if [ "$cerca" -eq 0 ] && [[ $line == '## '* ]]; then
      i=$((i + 1)); PTIT[i]=${line#\#\# }; clave "${PTIT[i]}"; PK[i]=$KEY; PT[i]=$line$'\n'
    elif [ "$i" -lt 0 ]; then PHEAD+=$line$'\n'
    else PT[i]+=$line$'\n'
    fi
  done <"$1"
}
# vacio <texto de sección>: rc 0 si, sin la cabecera ni los comentarios <!-- -->, no queda nada.
vacio() {
  local t=${1#*$'\n'}
  [ "$t" != "$1" ] || return 0
  awk 'BEGIN { c = 0 }
    { l = $0; o = ""
      while (l != "") {
        if (c) { i = index(l, "-->"); if (!i) { l = ""; break } l = substr(l, i + 3); c = 0 }
        else { i = index(l, "<!--"); if (!i) { o = o l; l = "" } else { o = o substr(l, 1, i - 1); l = substr(l, i + 4); c = 1 } }
      }
      if (o ~ /[^ \t]/) f = 1 }
    END { exit f ? 1 : 0 }' <<<"$t"
}

# --- el borrador: se valida entero antes de tocar nada ---
parsear "$DESDE"
DHEAD=$PHEAD; DK=("${PK[@]}"); DTIT=("${PTIT[@]}"); DT=("${PT[@]}")
# «Último turno (auto)» es de `--auto`: el borrador (que a veces copia el nucleo entero) no la sustituye ni la rechaza.
AUTOK="ultimo turno (auto)"
for ((i = ${#DK[@]} - 1; i >= 0; i--)); do
  [ "${DK[i]}" != "$AUTOK" ] || { unset 'DK[i]' 'DTIT[i]' 'DT[i]'; DK=("${DK[@]}"); DTIT=("${DTIT[@]}"); DT=("${DT[@]}"); }
done
[ "${#DK[@]}" -gt 0 ] || die 2 "el borrador no trae ninguna sección «## »"
if [ -n "${DHEAD//[$' \t\r\n']/}" ]; then
  while IFS= read -r l; do
    [[ -z ${l//[$' \t\r']/} || $l == '# '* ]] || die 2 "hay texto antes de la primera cabecera «## »: «${l:0:60}»"
  done <<<"$DHEAD"
fi
VISTAS=" "
for ((i = 0; i < ${#DK[@]}; i++)); do
  admitida "${DK[i]}" || die 2 "cabecera no admitida «${DTIT[i]}» (admitidas: Objetivo, Invariantes, Paso actual, Siguiente acción, Comandos de verificación, Plan, Pendientes, Ficheros tocados)"
  case $VISTAS in *" ${DK[i]} "*) die 2 "cabecera repetida «${DTIT[i]}»" ;; esac
  VISTAS+="${DK[i]} "
done
dindice() { local j; DI=-1; for ((j = 0; j < ${#DK[@]}; j++)); do [ "${DK[j]}" != "$1" ] || { DI=$j; return 0; }; done; }

# La misma extracción en ambos modos; decidir si el borrador está vacío va antes.
plan_abierto() {
  printf '%s' "$1" | awk -v d="$W/hechos" '
    /^[ \t]*(```|~~~)/ { c = !c }
    !c && /^[ \t]*(([-*]|[0-9]+\.)[ \t]+)?\[[xX]\]/ { print >> d; next }
    { print }'
}
: >"$W/hechos"

# ---------------------------------------------------------------- --desde con ESTADO.md como estado
# Mapeo borrador (secciones de nucleo.md) → ESTADO.md. Viñetas de la cabecera, que sustituyen a la suya (o se añaden si falta):
#   Objetivo → «- Objetivo (una línea):» (todo el cuerpo en una línea; solo si la existente está vacía o es RELLENAR) · Paso actual → «- Paso actual:» · Siguiente acción → «- Siguiente acción:»
#   (la primera línea va en la viñeta y el resto sangrado). Secciones, que sustituyen a la suya y se crean si faltan:
#   Decisiones → «## Decisiones» · Pendientes / Pendientes y riesgos → «## Pendientes y riesgos» · Comandos de verificación /
#   Cómo se comprueba → «## Cómo se comprueba». Invariantes: las de la persona se conservan y solo se añaden líneas nuevas (vacía o RELLENAR: se reemplaza).
#   Sin equivalente (Plan, Ficheros tocados): sección propia, reemplazada si ya existe; los [x] del Plan van a diario.md. Una sección vacía del borrador conserva la de ESTADO.md. El borrador no
#   puede dejar a ESTADO.md sin sus secciones: lo que no trae se queda como estaba.
if [ "$ESTMD" -eq 1 ]; then
  EST=$RAIZ/ESTADO.md
  cp -- "$EST" "$W/viejo.md"
  OLD_CK=$(cksum <"$W/viejo.md")
  parsear "$W/viejo.md"
  OK=("${PK[@]}"); OTIT=("${PTIT[@]}"); OT=("${PT[@]}"); HEADX=$PHEAD
  # cuerpo <clave>: BODY = cuerpo del borrador sin comentarios ni líneas en blanco extremas; rc 1 si no hay borrador o está vacío.
  cuerpo() {
    dindice "$1"; [ "$DI" -ge 0 ] && ! vacio "${DT[DI]}" || return 1
    printf '%s' "${DT[DI]#*$'\n'}" >"$W/cuerpo"
    BODY=$(_nucleo_sin_comentarios "$W/cuerpo" | awk 'NF { p = 1 } p { b[++n] = $0 } END { while (n && b[n] !~ /[^ \t]/) n--; for (i = 1; i <= n; i++) print b[i] }')
    [ -n "${BODY//[$' \t\r\n']/}" ]
  }
  # vineta <patrón de la línea> <etiqueta si falta> <cuerpo>: reemplaza la viñeta (con sus líneas sangradas) o, si falta, la añade tras
  # la última línea con texto de la cabecera. El resto de la cabecera sale tal cual (las líneas en blanco finales incluidas).
  vineta() {
    HEADX=$(printf '%s' "$HEADX" | B=$3 awk -v pat="$1" -v def="$2" '
      function put(s) { out[++m] = s }
      function emit(label,   n, a, i) { n = split(ENVIRON["B"], a, "\n"); put("- " label ": " a[1]); for (i = 2; i <= n; i++) put(a[i] ~ /[^ \t]/ ? "  " a[i] : "") }
      skip && /^[ \t]+[^ \t]/ { next }
      { skip = 0 }
      /^[ \t]*(```|~~~)/ { f = !f }
      !f && !done && $0 ~ pat { l = $0; sub(/^- /, "", l); sub(/:.*/, "", l); emit(l); done = 1; skip = 1; next }
      { put($0) }
      END {
        if (!done) {
          last = m; while (last > 0 && out[last] !~ /[^ \t]/) last--
          for (i = last + 1; i <= m; i++) tail[++t] = out[i]
          m = last; emit(def); if (!t) put("")
          for (i = 1; i <= t; i++) put(tail[i])
        }
        for (i = 1; i <= m; i++) print out[i]
      }'; printf x)
    HEADX=${HEADX%x}
  }
  # sin_marca <texto>: quita la viñeta «- » o «* » inicial.
  sin_marca() { local t=$1; t=${t#"${t%%[![:space:]]*}"}; case $t in '- '* | '* '*) t=${t:2} ;; esac; printf '%s' "$t"; }
  # con_resto <texto>: la primera línea sin su viñeta y, sangradas por vineta, las demás.
  con_resto() { local r=""; [ "$1" = "${1#*$'\n'}" ] || r=$'\n'${1#*$'\n'}; printf '%s%s' "$(sin_marca "${1%%$'\n'*}")" "$r"; }
  # vacio_e <sección con cabecera>: como vacio, y las líneas con RELLENAR (plantilla sin rellenar) cuentan como vacías.
  vacio_e() {
    vacio "$1" && return 0
    printf '%s' "${1#*$'\n'}" >"$W/ve"
    _nucleo_sin_comentarios "$W/ve" | awk '/RELLENAR/ { next } /[^ \t]/ { f = 1 } END { exit f ? 1 : 0 }'
  }
  # bvacio <patrón>: la viñeta de la cabecera (fuera de cercas, con sus líneas sangradas) no existe, está vacía o es de plantilla.
  bvacio() {
    printf '%s' "$HEADX" | awk -v pat="$1" '
      /^[ \t]*(```|~~~)/ { f = !f; skip = 0; next }
      skip && /^[ \t]+[^ \t]/ { v = v $0; next }
      { skip = 0 }
      !f && !done && $0 ~ pat { l = $0; sub(/^[^:]*:/, "", l); v = l; done = 1; skip = 1 }
      END { gsub(/[ \t]/, "", v); exit (v == "" || v ~ /RELLENAR/) ? 0 : 1 }'
  }
  EXTRAS=""
  if cuerpo objetivo && bvacio '^- Objetivo'; then
    OBJ=$(tr '\n' ' ' <<<"$BODY" | tr -s ' '); OBJ=$(sin_marca "${OBJ% }")
    vineta '^- Objetivo' 'Objetivo (una línea)' "$OBJ"
  fi
  if cuerpo "paso actual"; then vineta '^- Paso actual' 'Paso actual' "$(con_resto "$BODY")"; fi
  if cuerpo "siguiente accion"; then vineta '^- Siguiente acci' 'Siguiente acción' "$(con_resto "$BODY")"; fi
  # sec_e <título> <texto del borrador con cabecera> <texto original o vacío>: SEC = la sección con su título, el cuerpo del borrador sin
  # líneas en blanco finales y detrás tantos saltos como tenía la original (la separación con la siguiente se conserva).
  sec_e() {
    local b=${2#*$'\n'} o=$3 n=0 x
    while [[ $b == *$'\n' ]]; do b=${b%$'\n'}; done
    while [[ $o == *$'\n' ]]; do o=${o%$'\n'}; n=$((n + 1)); done
    [ "$n" -ge 1 ] || n=1
    SEC="## $1"$'\n'$b
    for ((x = 0; x < n; x++)); do SEC+=$'\n'; done
  }
  # Solo se sustituye la PRIMERA sección de cada clave; las demás, y todo lo que el borrador no trae, salen tal cual.
  # RA[i]=1: sección añadida por el borrador (sin equivalente en ESTADO.md): la única que el tope puede omitir.
  RK=(); RT=(); RA=(); HECHA=" "
  for ((i = 0; i < ${#OK[@]}; i++)); do
    k=${OK[i]}; dindice "$k"; di=$DI
    RK+=("$k"); RA+=(0)
    case $k in objetivo | "paso actual" | "siguiente accion") RT+=("${OT[i]}"); continue ;; esac
    if [ "$k" = invariantes ] && [ "$di" -ge 0 ] && [[ $HECHA != *" $k "* ]] && ! vacio "${DT[di]}" && ! vacio_e "${OT[i]}"; then
      # Las Invariantes de la persona no se tocan: solo se añaden las líneas del borrador que no estén ya (misma regla que nucleo.md).
      HECHA+="$k "; t=${OT[i]}; n=0
      while [[ $t == *$'\n' ]]; do t=${t%$'\n'}; n=$((n + 1)); done
      while IFS= read -r l; do
        tl=${l#"${l%%[![:space:]]*}"}; tl=${tl%"${tl##*[![:space:]]}"}
        [ -n "$tl" ] && [[ $tl != *RELLENAR* ]] || continue
        yaesta=0
        while IFS= read -r ol; do
          ol=${ol#"${ol%%[![:space:]]*}"}; ol=${ol%"${ol##*[![:space:]]}"}
          [ "$ol" != "$tl" ] || { yaesta=1; break; }
        done <<<"${t#*$'\n'}"
        [ "$yaesta" -eq 1 ] || t+=$'\n'$l
      done <<<"${DT[di]#*$'\n'}"
      [ "$n" -ge 1 ] || n=1
      for ((x = 0; x < n; x++)); do t+=$'\n'; done
      RT+=("$t"); continue
    fi
    if [ "$di" -ge 0 ] && [[ $HECHA != *" $k "* ]] && ! vacio "${DT[di]}"; then
      HECHA+="$k "; sec_e "${OTIT[i]}" "${DT[di]}" "${OT[i]}"; RT+=("$SEC")
      case $k in decisiones | pendientes | "comandos de verificacion") ;; *) EXTRAS+="|${OTIT[i]}" ;; esac
    else RT+=("${OT[i]}")
    fi
  done
  for ((j = 0; j < ${#DK[@]}; j++)); do
    k=${DK[j]}
    case $k in objetivo | "paso actual" | "siguiente accion") continue ;; esac
    [[ $HECHA == *" $k "* ]] && continue
    vacio "${DT[j]}" && continue
    case $k in
      decisiones) T=Decisiones ;;
      pendientes) T="Pendientes y riesgos" ;;
      "comandos de verificacion") T="Cómo se comprueba" ;;
      *) titulo_de "${DTIT[j]}"; T=$TITULO; EXTRAS+="|$T" ;;
    esac
    ult=$HEADX; [ "${#RT[@]}" -eq 0 ] || ult=${RT[${#RT[@]} - 1]}
    sec_e "$T" "${DT[j]}" ""; [[ $ult == *$'\n\n' ]] || SEC=$'\n'$SEC
    HECHA+="$k "; RK+=("$k"); RT+=("$SEC"); RA+=(1)
  done
  # Solo el Plan aportado sustituye al anterior; un Plan terminado puede quedar sin cuerpo.
  if [[ $HECHA == *" plan "* ]]; then
    for ((i = 0; i < ${#RK[@]}; i++)); do
      [ "${RK[i]}" = plan ] || continue
      RT[i]=$(plan_abierto "${RT[i]}" && printf x)
      RT[i]=${RT[i]%x}
      break
    done
  fi
  armar_e() {
    local i; TEXTO=$HEADX
    for ((i = 0; i < ${#RK[@]}; i++)); do TEXTO+=${RT[i]}; done
    [ "$NOEOL" -eq 0 ] || TEXTO=${TEXTO%$'\n'}
  }
  NOEOL=0; [ -z "$(tail -c1 "$EST")" ] || NOEOL=1
  CRLF=0; IFS= read -r l1 <"$EST" || true; [[ ${l1-} != *$'\r' ]] || CRLF=1
  armar_e
  # ESTADO.md es de la persona: el tope solo omite (a diario.md) las secciones que el borrador añadió sin equivalente, desde el final.
  # Si aun así lo pasa se escribe igual y se avisa: la inyección de SessionStart ya recorta.
  OMITIDAS=""
  for ((i = ${#RK[@]} - 1; i >= 0; i--)); do
    [ "$(bytes "$TEXTO")" -gt "$TOPE" ] || break
    [ "${RA[i]}" -eq 1 ] && [ -n "${RT[i]}" ] || continue
    t=${RT[i]#$'\n'}; t=${t%%$'\n'*}; t=${t#\#\# }
    printf '## %s omitido por tope: %s\n%s\n' "$HOY" "$t" "${RT[i]#*$'\n'}" >>"$W/omitido"
    OMITIDAS+=" $t"; RT[i]=""; armar_e
  done
  [ -z "$OMITIDAS" ] || avisar "omitidas por tope (${TOPE} B), copia en diario.md:$OMITIDAS"
  AVTOPE=""
  [ "$(bytes "$TEXTO")" -le "$TOPE" ] || AVTOPE="ESTADO.md ocupa $(bytes "$TEXTO") B y supera el tope (${TOPE} B): recórtalo a mano; la inyección de SessionStart ya lo recorta"
  TEXTOW=$TEXTO; [ "$CRLF" -eq 0 ] || TEXTOW=${TEXTO//$'\n'/$'\r\n'}

  [ -z "${NUCLEO_FUSION_PAUSA:-}" ] || sleep "$NUCLEO_FUSION_PAUSA"
  [ "$(cksum <"$EST")" = "$OLD_CK" ] || die 4 "ESTADO.md cambió mientras se fusionaba (otra sesión): no lo piso; reintenta"
  # Solo si el texto cambia: copia previa, rotación (3, por mtime) y escritura.
  CAMBIADO=0
  if [ "$(printf '%s' "$TEXTOW" | cksum)" != "$OLD_CK" ]; then
    CAMBIADO=1
    mkdir -p "$E"
    P=$E/ESTADO.prev-$(date -u +%Y%m%dT%H%M%SZ).md
    [ ! -e "$P" ] || P=${P%.md}-$$.md
    cp -- "$W/viejo.md" "$P"
    # shellcheck disable=SC2012  # nombres propios (ESTADO.prev-FECHA.md), y hace falta el orden por mtime
    mapfile -t COPIAS < <(ls -1t "$E"/ESTADO.prev-*.md 2>/dev/null)
    for ((i = 3; i < ${#COPIAS[@]}; i++)); do rm -f -- "${COPIAS[i]}"; done
    TMP=$(mktemp "$RAIZ/.ESTADO.XXXXXX")
    printf '%s' "$TEXTOW" >"$TMP"
    chmod "$(stat -c %a "$EST" 2>/dev/null || stat -f %Lp "$EST")" "$TMP" 2>/dev/null || true
    mv -f -- "$TMP" "$EST"; TMP=""
  fi
  # Un cierre nuevo también se conserva cuando el documento activo ya tiene los mismos bytes.
  if [ "$CAMBIADO" -eq 1 ] || [ -s "$W/hechos" ] || [ -s "$W/omitido" ]; then
    HASH=$(git -C "$RAIZ" rev-parse --short HEAD 2>/dev/null || echo sin-commit)
    # shellcheck disable=SC2094  # La omision se compara antes de anexarla; nunca se trunca el diario.
    {
      [ -s "$DIARIO" ] || printf '# Diario\n'
      while IFS= read -r l; do
        l=${l#"${l%%[![:space:]]*}"}; l=${l#[-*] }; l=${l#[0-9]*. }; l=${l#\[[xX]\]}; l=${l# }
        [ -n "$l" ] && [[ $YA != *$'\n'"$l"$'\n'* ]] || continue
        YA+=$l$'\n'
        printf -- '- %s · %s · %s\n' "$HOY" "$l" "$HASH"
      done <"$W/hechos"
      if [ -s "$W/omitido" ] && [[ $(<"$DIARIO") != *"$(<"$W/omitido")"* ]]; then
        cat "$W/omitido"
      fi
    } >>"$DIARIO"
  fi
  ERRC=""
  if [ "$COMMIT" -eq 1 ]; then
    if ! git -C "$RAIZ" add -- ESTADO.md; then ERRC="ESTADO.md escrito, pero git add falló"
    elif ! git -C "$RAIZ" diff --cached --quiet -- ESTADO.md; then
      git -C "$RAIZ" commit -q -m "docs(estado): handoff de $HOY" -- ESTADO.md || ERRC="ESTADO.md escrito, pero el commit falló"
    fi
  fi
  if EX=$(git -C "$RAIZ" rev-parse --git-path info/exclude 2>/dev/null); then
    case $EX in /*) ;; *) EX=$RAIZ/$EX ;; esac
    mkdir -p "$(dirname "$EX")" 2>/dev/null || true
    command grep -qFx '.claude/estado/' "$EX" 2>/dev/null || printf '.claude/estado/\n' >>"$EX" 2>/dev/null || true
  fi
  if D=$(nucleo_dueno "$RAIZ"); then
    if [ -z "$SESION" ] || [ "${D% *}" = "$SESION" ] || ! nucleo_dueno_vigente "$RAIZ" >/dev/null; then rm -f -- "$E/.dueno"
    else avisar "la sesión dueña es otra (${D% *}): no se libera"
    fi
  fi
  # El aviso de tope es permanente mientras ESTADO.md pase del tope.
  [ -z "$AVTOPE" ] || avisar "$AVTOPE"
  avisos_stderr
  if [ "$JSON" = 1 ]; then
    SHA=$(sha256sum <"$EST" | cut -d' ' -f1)
    jq -cn --arg n "$EST" --arg s "$SHA" --arg x "${EXTRAS#|}" --arg tr "$TRANSCRIPT" --argjson b "$(wc -c <"$EST" | tr -d ' ')" '{nucleo:$n,sha256:$s,transcript:(if $tr == "" then null else $tr end),bytes:$b,modo:"estado-md",extras:($x | split("|") | map(select(. != "")))} + (if ($ARGS.positional | length) == 0 then {} else {avisos:$ARGS.positional} end)' --args ${AV[@]+"${AV[@]}"}
  else
    echo "handoff: $EST escrito ($(wc -c <"$EST" | tr -d ' ') B de $TOPE)"
    [ -z "$EXTRAS" ] || echo "handoff: sin equivalente en ESTADO.md, añadidas como secciones propias: ${EXTRAS#|}"
  fi
  [ -z "$ERRC" ] || die 1 "$ERRC"
  exit 0
fi

# --- el nucleo actual ---
OLD_CK=ausente; [ ! -f "$NUC" ] || OLD_CK=$(cksum <"$NUC")
HAYVIEJO=0; [ -f "$ORIGEN" ] && [ -s "$ORIGEN" ] && HAYVIEJO=1
[ "$HAYVIEJO" -eq 0 ] || cp --preserve=timestamps -- "$ORIGEN" "$W/viejo.md"

RK=(); RT=(); HEAD="# Estado"$'\n'$'\n'
if [ "$HAYVIEJO" -eq 1 ] && [ "$SOLO" -eq 0 ]; then
  parsear "$W/viejo.md"
  OK=("${PK[@]}"); OT=("${PT[@]}"); HEAD=$PHEAD
  [ -n "$HEAD" ] || HEAD="# Estado"$'\n'$'\n'
  USADAS=" "; CAMBIADAS=" "
  for ((i = 0; i < ${#OK[@]}; i++)); do
    k=${OK[i]}; dindice "$k"; di=$DI
    case $k in
      objetivo | invariantes)
        if ! vacio "${OT[i]}"; then
          t=${OT[i]}
          if [ "$k" = invariantes ] && [ "$di" -ge 0 ]; then
            while IFS= read -r l; do
              tl=${l#"${l%%[![:space:]]*}"}; tl=${tl%"${tl##*[![:space:]]}"}
              [ -n "$tl" ] || continue
              yaesta=0
              while IFS= read -r ol; do
                ol=${ol#"${ol%%[![:space:]]*}"}; ol=${ol%"${ol##*[![:space:]]}"}
                [ "$ol" != "$tl" ] || { yaesta=1; break; }
              done <<<"${t#*$'\n'}"
              [ "$yaesta" -eq 1 ] || { fin_nl t; t+=$l$'\n'; }
            done <<<"${DT[di]#*$'\n'}"
          fi
          [ "$di" -lt 0 ] || USADAS+="$k "
          RK+=("$k"); RT+=("$t")
        elif [ "$di" -ge 0 ] && ! vacio "${DT[di]}"; then
          USADAS+="$k "; RK+=("$k"); RT+=("${OT[i]%%$'\n'*}"$'\n'"${DT[di]#*$'\n'}")
        else [ "$di" -lt 0 ] || USADAS+="$k "; RK+=("$k"); RT+=("${OT[i]}")
        fi ;;
      *)
        if [ "$di" -ge 0 ] && [[ $CAMBIADAS != *" $k "* ]]; then
          titulo_de "${DTIT[di]}"; USADAS+="$k "; CAMBIADAS+="$k "
          if vacio "${DT[di]}" && ! vacio "${OT[i]}"; then RK+=("$k"); RT+=("${OT[i]}")
          else RK+=("$k"); RT+=("## $TITULO"$'\n'"${DT[di]#*$'\n'}")
          fi
        elif [[ $CAMBIADAS == *" $k "* ]]; then :
        else RK+=("$k"); RT+=("${OT[i]}")
        fi ;;
    esac
  done
  for ((j = 0; j < ${#DK[@]}; j++)); do
    [[ $USADAS == *" ${DK[j]} "* ]] && continue
    titulo_de "${DTIT[j]}"; RK+=("${DK[j]}"); RT+=("## $TITULO"$'\n'"${DT[j]#*$'\n'}")
  done
else
  for ((j = 0; j < ${#DK[@]}; j++)); do titulo_de "${DTIT[j]}"; RK+=("${DK[j]}"); RT+=("## $TITULO"$'\n'"${DT[j]#*$'\n'}"); done
fi

# Los [x] del Plan (fuera de las cercas) salen del nucleo y van a diario con su comando y el hash de HEAD.
for ((i = 0; i < ${#RK[@]}; i++)); do
  [ "${RK[i]}" = plan ] || continue
  RT[i]=$(plan_abierto "${RT[i]}")$'\n'
done

# El último rc de cada comando de verificaciones.log, junto a su línea de «Comandos de verificación».
LCMD=(); LRC=()
if [ -f "$VLOG" ]; then
  while IFS=$'\t' read -r _ rc cmd; do
    [ -n "${cmd:-}" ] || continue
    case $rc in '' | *[!0-9]*) continue ;; esac
    nl=()
    for ((j = 0; j < ${#LCMD[@]}; j++)); do
      if [ "${LCMD[j]}" != "$cmd" ]; then nl+=("$j"); fi
    done
    NC=(); NR=(); for j in "${nl[@]}"; do NC+=("${LCMD[j]}"); NR+=("${LRC[j]}"); done
    LCMD=("${NC[@]}" "$cmd"); LRC=("${NR[@]}" "$rc")
  done < <(tail -n 100 "$VLOG")
fi
if [ "${#LCMD[@]}" -gt 0 ]; then
  ult=$((${#LCMD[@]} - 1)); casada=0; ci=-1
  for ((i = 0; i < ${#RK[@]}; i++)); do [ "${RK[i]}" != "comandos de verificacion" ] || ci=$i; done
  if [ "$ci" -ge 0 ]; then
    out=""; prim=1
    while IFS= read -r l; do
      if [ "$prim" -eq 1 ]; then prim=0; out+=$l$'\n'; continue; fi
      if [[ $l != '<!--'* ]]; then
        campo=${l#"${l%%[![:space:]]*}"}
        if [[ $campo =~ ^([-*+]|[0-9]+[.\)])[[:space:]]+ ]]; then
          campo=${campo:${#BASH_REMATCH[0]}}
        fi
        case $campo in \*\*\`*\`\*\** | __\`*\`__*) campo=${campo:2} ;; esac
        if [[ $campo == \`* ]]; then campo=${campo#\`}; campo=${campo%%\`*}
        else
          campo=${campo%% → rc=*}
          case $campo in \*\**\*\* | __*__) campo=${campo:2:${#campo}-4} ;; esac
        fi
        for ((j = ${#LCMD[@]} - 1; j >= 0; j--)); do
          [ "$campo" = "${LCMD[j]}" ] || continue
          l="${l%% → rc=[0-9]*} → rc=${LRC[j]}"
          [ "$j" -ne "$ult" ] || casada=1
          break
        done
      fi
      out+=$l$'\n'
    done <<<"${RT[ci]}"
    if [ "$casada" -eq 0 ]; then fin_nl out; out+="- \`${LCMD[ult]}\` → rc=${LRC[ult]}"$'\n'; fi
    RT[ci]=$out
  else
    RK+=("comandos de verificacion"); RT+=("## Comandos de verificación"$'\n'"- \`${LCMD[ult]}\` → rc=${LRC[ult]}"$'\n')
  fi
fi

# «Ficheros tocados» sale de git, no de lo que se escribió a mano: los cambios desde el handoff anterior (el sha del
# marcador del bloque; sin él, el último commit anterior a la fecha del nucleo viejo) más el working tree. El texto a
# mano de la sección se conserva debajo; solo se reemplaza el bloque generado.
tocados_git() {
  local base="" sha cut st n l prev
  [ -n "${RAIZ:-}" ] && sha=$(timeout 5 git -c core.fsmonitor=false -C "$RAIZ" rev-parse --verify -q HEAD 2>/dev/null) || return 0
  if [ "$HAYVIEJO" -eq 1 ]; then
    base=$(sed -n 's/^<!-- git:\([0-9a-f]\{7,40\}\) -->$/\1/p' "$W/viejo.md" | head -n 1)
    if [ -n "$base" ] && git -C "$RAIZ" merge-base --is-ancestor "$base" HEAD 2>/dev/null; then :
    else
      cut=$(stat -c %Y "$W/viejo.md" 2>/dev/null); base=""
      [ -z "$cut" ] || base=$(git -C "$RAIZ" rev-list -1 --before="@$cut" HEAD 2>/dev/null)
    fi
  fi
  TOCADOS="<!-- git:$sha -->"$'\n'
  n=0
  if [ -n "$base" ]; then
    while IFS=$'\t' read -r a d f; do
      [ -n "$f" ] || continue
      case $f in .claude/estado/*) continue ;; esac
      n=$((n + 1)); [ "$n" -le 25 ] || continue
      TOCADOS+="- ${f//[[:cntrl:]]/} (+$a -$d)"$'\n'
    done < <(timeout 5 git -c core.fsmonitor=false -C "$RAIZ" diff --numstat "$base" HEAD 2>/dev/null)
  fi
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    st=${l:3}; case $st in .claude/estado/*) continue ;; esac
    n=$((n + 1)); [ "$n" -le 25 ] || continue
    TOCADOS+="- ${st//[[:cntrl:]]/} (sin commitear)"$'\n'
  done < <(timeout 5 git -c core.fsmonitor=false -C "$RAIZ" status --porcelain 2>/dev/null)
  [ "$n" -le 25 ] || TOCADOS+="- … y $((n - 25)) más: git diff --stat"$'\n'
  TOCADOS+="<!-- /git -->"$'\n'
  # Mismo contenido que el bloque anterior: se conserva con su sha, para que un handoff repetido (o un --commit que solo
  # movió HEAD) no reescriba el nucleo.
  if [ "$HAYVIEJO" -eq 1 ]; then
    prev=$(awk '/^<!-- git:[0-9a-f]+ -->$/ { g = 1 } g { print } g && /^<!-- \/git -->$/ { exit }' "$W/viejo.md")
    [ -z "$prev" ] || [ "$(sed 1d <<<"$prev")" != "$(sed 1d <<<"${TOCADOS%$'\n'}")" ] || TOCADOS=$prev$'\n'
  fi
}
TOCADOS=""
tocados_git
if [ -n "$TOCADOS" ]; then
  fi_=-1; for ((i = 0; i < ${#RK[@]}; i++)); do [ "${RK[i]}" != "ficheros tocados" ] || fi_=$i; done
  if [ "$fi_" -ge 0 ]; then
    mano=$(awk 'NR == 1 { next } /^<!-- git:[0-9a-f]+ -->$/ { g = 1; next } g && /^<!-- \/git -->$/ { g = 0; next } !g { print }' <<<"${RT[fi_]}")
    RT[fi_]="${RT[fi_]%%$'\n'*}"$'\n'"$TOCADOS"
    [ -z "$mano" ] || RT[fi_]+=$mano$'\n'
  else RK+=("ficheros tocados"); RT+=("## Ficheros tocados"$'\n'"$TOCADOS")
  fi
fi

# La sección de --auto va la última, también si este borrador añadió secciones tras ella.
for ((i = 0; i < ${#RK[@]}; i++)); do
  [ "${RK[i]}" = "$AUTOK" ] && [ -n "${RT[i]}" ] || continue
  RK+=("$AUTOK"); RT+=("${RT[i]}"); RK[i]=""; RT[i]=""; break
done

# armar: el nucleo entero con su cabecera (sin la nota de recorte previa) y, si se omitió algo, la nota nueva.
OMITIDAS=""
armar() {
  local h="" l t i
  while IFS= read -r l; do case $l in '> handoff '* | '> sesión anterior: '* | '> carpeta de trabajo: '*) ;; *) h+=$l$'\n' ;; esac; done <<<"${HEAD%$'\n'}"
  [ -z "$OMITIDAS" ] || h+="> handoff $HOY: omitidas por tope (copia en diario.md):$OMITIDAS"$'\n'
  [ -z "$TRANSCRIPT" ] || h+="> sesión anterior: $TRANSCRIPT · volver: claude --resume $SESION · buscar en él con rg, nunca leerlo entero"$'\n'
  [ -z "$CARPETA" ] || h+="> carpeta de trabajo: $CARPETA"$'\n'
  t=$h
  for ((i = 0; i < ${#RK[@]}; i++)); do [ -z "${RT[i]}" ] || { fin_nl "RT[$i]"; t+=${RT[i]}; }; done
  TEXTO=$t
}
armar
# Se omiten secciones enteras: primero las ajenas a la plantilla (desde el final), luego las de plantilla desde el
# final del orden D5 hasta Comandos (Objetivo, Invariantes y Siguiente acción no se tocan); lo omitido va al diario.
omitir() {
  local t=${RT[$1]%%$'\n'*}; t=${t#\#\# }
  printf '## %s omitido por tope: %s\n%s\n' "$HOY" "$t" "${RT[$1]#*$'\n'}" >>"$W/omitido"
  OMITIDAS+=" $t"
  RT[$1]=""; armar
}
# recortar: Paso actual se corta en un límite de línea, con aviso, hasta caber (y cierra la valla que deje abierta); el
# original va entero al diario. Si no cabe ni una línea, se omite.
RECORTADA=""
recortar() {
  local t=${RT[$1]%%$'\n'*} b=${RT[$1]#*$'\n'} out
  local aviso="[handoff: recortado al tope; el texto entero está en diario.md]"
  out=$(printf '%s' "$b" | LC_ALL=C awk -v m="$(( $(bytes "$b") - $(bytes "$TEXTO") + TOPE - $(bytes "$aviso") - 5 ))" \
    '{ n += length($0) + 1; if (n > m) exit; print } /^[ \t]*```+[^`]*$/ { v = !v } END { if (v) print "```" }')
  [ -n "$out" ] || { omitir "$1"; return; }
  printf '## %s recortado por tope: %s\n%s\n' "$HOY" "${t#\#\# }" "$b" >>"$W/omitido"
  RECORTADA=${t#\#\# }
  RT[$1]=$t$'\n'$out$'\n'$aviso$'\n'; armar
}
for ((i = ${#RK[@]} - 1; i >= 0; i--)); do
  [ "$(bytes "$TEXTO")" -gt "$TOPE" ] || break
  # La sección de --auto es regenerable: lo primero que sale, sin copia en diario.md ni aviso.
  if [ "${RK[i]}" = "$AUTOK" ] && [ -n "${RT[i]}" ]; then RT[i]=""; armar; continue; fi
  admitida "${RK[i]}" || [ -z "${RT[i]}" ] || omitir "$i"
done
for k in pendientes plan "ficheros tocados" "comandos de verificacion" "paso actual"; do
  [ "$(bytes "$TEXTO")" -gt "$TOPE" ] || break
  for ((i = 0; i < ${#RK[@]}; i++)); do
    [ "${RK[i]}" = "$k" ] && [ -n "${RT[i]}" ] || continue
    if [ "$k" = "paso actual" ]; then recortar "$i"; else omitir "$i"; fi
  done
done
[ -z "$OMITIDAS" ] || avisar "omitidas por tope (${TOPE} B), copia en diario.md:$OMITIDAS"
[ -z "$RECORTADA" ] || avisar "$RECORTADA recortado al tope (${TOPE} B), entero en diario.md"
if [ "$(bytes "$TEXTO")" -gt "$TOPE" ]; then
  avisar "Objetivo, Invariantes y Siguiente acción solos pasan del tope: no se tocan; acórtalos o mueve lo cerrado a diario.md a mano"
fi

# --- escritura ---
[ -z "${NUCLEO_FUSION_PAUSA:-}" ] || sleep "$NUCLEO_FUSION_PAUSA"
NEW_CK=ausente; [ ! -f "$NUC" ] || NEW_CK=$(cksum <"$NUC")
[ "$NEW_CK" = "$OLD_CK" ] || die 4 "nucleo.md cambió mientras se fusionaba (otra sesión): no lo piso; reintenta"
mkdir -p "$E"
if [ "$HAYVIEJO" -eq 1 ]; then
  # Un handoff que no cambia el nucleo no desplaza la última versión distinta de las 3 copias (como en modo ESTADO.md).
  if [ "$(printf '%s' "$TEXTO" | cksum)" != "$OLD_CK" ]; then
    P=$E/nucleo.prev-$(date -u +%Y%m%dT%H%M%SZ).md
    [ ! -e "$P" ] || P=${P%.md}-$$.md
    cp -- "$W/viejo.md" "$P"
    mapfile -t COPIAS < <(printf '%s\n' "$E"/nucleo.prev-*.md | sort)
    for ((i = 0; i < ${#COPIAS[@]} - 3; i++)); do rm -f -- "${COPIAS[i]}"; done
  fi
fi
TMP=$(mktemp "$E/.nucleo.XXXXXX")
printf '%s' "$TEXTO" >"$TMP"
mv -f -- "$TMP" "$NUC"
rm -f -- "$E/autosave.dirty"
[ -z "$SES" ] || case $SESION in '' | *[!A-Za-z0-9_-]*) ;; *) [ "$(cat "$SES/.sesion" 2>/dev/null)" = "$SESION" ] || printf '%s\n' "$SESION" >"$SES/.sesion" 2>/dev/null || true ;; esac
[ -z "$VSLOT" ] || case $SESION in '' | *[!A-Za-z0-9_-]*) ;; *) [ "$(cat "$VSLOT/.sesion" 2>/dev/null)" = "$SESION" ] || printf '%s\n' "$SESION" >"$VSLOT/.sesion" 2>/dev/null || true ;; esac
[ -n "$SES" ] || [ "$E" = "$RAIZ/.claude/estado" ] || : >"$E/.nucleo-fallback"

HASH=sin-commit; [ -n "$SES" ] || HASH=$(git -C "$RAIZ" rev-parse --short HEAD 2>/dev/null || echo sin-commit)
SINCMD=0
# shellcheck disable=SC2094  # diario.md solo se añade; lo que se lee es $W/hechos
{
  [ -s "$DIARIO" ] || printf '# Diario\n'
  while IFS= read -r l; do
    l=${l#"${l%%[![:space:]]*}"}; l=${l#[-*] }; l=${l#[0-9]*. }; l=${l#\[[xX]\]}; l=${l# }
    [ -n "$l" ] || continue
    # Forma, no contenido: «` `» cuenta como comando. Marca el cierre sin comando por descuido, no al que lo esquiva.
    # shellcheck disable=SC2016  # Backticks literales: el comando va entre ellos.
    sc=""; [[ $l == *\`?*\`* ]] || { sc=" (sin comando)"; SINCMD=$((SINCMD + 1)); }
    [[ $YA != *$'\n'"$l$sc"$'\n'* ]] || continue
    YA+=$l$sc$'\n'
    l+=$sc
    printf -- '- %s · %s · %s\n' "$HOY" "$l" "$HASH"
  done <"$W/hechos"
  [ ! -s "$W/omitido" ] || cat "$W/omitido"
} >>"$DIARIO"

[ -n "$SES" ] || nucleo_registrar "$RAIZ"
ERRC=""
if [ "$COMMIT" -eq 1 ] && [ "$E" != "$RAIZ/.claude/estado" ]; then
  ERRC="nucleo.md escrito en $E; --commit no puede versionar el estado fuera del proyecto"
elif [ "$COMMIT" -eq 1 ]; then
  GI=$E/.gitignore
  for pat in .dueno '.dueno.*' '.nucleo.*' .handoff.lock verificaciones.log recortes.log 'nucleo.prev-*' 'checkpoint-compact*'; do
    command grep -qFx -- "$pat" "$GI" 2>/dev/null || printf '%s\n' "$pat" >>"$GI"
  done
  # -f: una ejecución previa sin --commit dejó .claude/estado/ en info/exclude. Solo lo que se versiona; nunca lo efímero.
  PATHS=(.claude/estado/nucleo.md .claude/estado/diario.md .claude/estado/.gitignore)
  [ ! -d "$E/archivo" ] || PATHS+=(.claude/estado/archivo)
  if ! git -C "$RAIZ" add -f -- "${PATHS[@]}"; then ERRC="nucleo.md escrito, pero git add falló"
  elif ! git -C "$RAIZ" diff --cached --quiet -- "${PATHS[@]}"; then
    git -C "$RAIZ" commit -q -m "docs(estado): handoff de $HOY" -- "${PATHS[@]}" || ERRC="nucleo.md escrito, pero el commit falló"
  fi
elif [ -z "$SES" ] && EX=$(git -C "$RAIZ" rev-parse --git-path info/exclude 2>/dev/null); then
  case $EX in /*) ;; *) EX=$RAIZ/$EX ;; esac
  mkdir -p "$(dirname "$EX")" 2>/dev/null || true
  command grep -qFx '.claude/estado/' "$EX" 2>/dev/null || printf '.claude/estado/\n' >>"$EX" 2>/dev/null || true
fi

# El dueño: solo lo libera quien lo es (o nadie lo es ya).
if [ -z "$SES" ] && D=$(nucleo_dueno "$RAIZ"); then
  if [ -z "$SESION" ] || [ "${D% *}" = "$SESION" ] || ! nucleo_dueno_vigente "$RAIZ" >/dev/null; then rm -f -- "$E/.dueno"
  else avisar "la sesión dueña es otra (${D% *}): no se libera"
  fi
fi
[ "$SINCMD" -eq 0 ] || avisar "$SINCMD cierre(s) sin comando de verificación"
avisos_stderr
if [ "$JSON" = 1 ]; then
  SHA=$(printf '%s' "$TEXTO" | sha256sum | cut -d' ' -f1)
  jq -cn --arg n "$NUC" --arg s "$SHA" --arg tr "$TRANSCRIPT" --argjson b "$(bytes "$TEXTO")" '{nucleo:$n,sha256:$s,transcript:(if $tr == "" then null else $tr end),bytes:$b} + (if ($ARGS.positional | length) == 0 then {} else {avisos:$ARGS.positional} end)' --args ${AV[@]+"${AV[@]}"}
else echo "handoff: $NUC escrito ($(bytes "$TEXTO") B de $TOPE)"
fi
[ -z "$ERRC" ] || die 1 "$ERRC"
