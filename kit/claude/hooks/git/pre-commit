#!/bin/bash
# pre-commit — bloquea el commit si el INDICE (lo que realmente se va a
# comitear) contiene secretos, segun gitleaks.
#
# Capa 2 de la arquitectura de dos capas descrita en docs/05-security.md. La
# capa 1 (../secret-guard.sh, PreToolUse) es un filtro barato por nombre de
# fichero, sabido incompleto. Esta capa ve el indice real via
# `gitleaks git --staged`, no el texto del comando ni el arbol de trabajo:
# cubre `git add` en cualquier forma (cd, subshells, alias, xargs) y
# `git commit -am`, porque en todos los casos lo que llega aqui es el mismo
# indice.
#
# Se activa via `git config core.hooksPath claude/hooks/git` (relativo a
# CLAUDE_HOME una vez instalado) — un hook en .git/hooks/ no se versiona y
# podria perderse en silencio sin que ningun test lo notara. Ver
# kit/test/test_secret_content_gitleaks.sh para la regresion.
#
# Dependencia: gitleaks (Go, MIT) — ver docs/02-install.md para instalarlo.
# doctor.sh avisa (WARN) si no esta presente en PATH.

GITLEAKS="$(command -v gitleaks || true)"
[ -z "$GITLEAKS" ] && [ -x "$HOME/.local/bin/gitleaks" ] && GITLEAKS="$HOME/.local/bin/gitleaks"

if [ -z "$GITLEAKS" ]; then
  echo "BLOCKED: gitleaks no encontrado (ni en PATH ni en ~/.local/bin/gitleaks)." >&2
  echo "Instala gitleaks o el commit no puede verificarse en busca de secretos." >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --ignore-gitleaks-allow: sin este flag, un comentario "# gitleaks:allow" en
# el propio contenido commiteado silencia el hallazgo sin dejar rastro
# auditable (peor que --no-verify, que al menos es un acto explicito fuera
# del contenido). env -u GITLEAKS_CONFIG: evita que una variable de entorno
# apuntando a una config permisiva sustituya la config por defecto sin aviso.
#
# -c CONFIG: el fichero de config anade una regla propia (contraseñas tipo
# diccionario en ficheros de config, ver ese fichero) que EXTIENDE las reglas
# por defecto (useDefault = true). Se pasa explicito porque, aun cuando
# gitleaks a veces recoge un .gitleaks.toml en el path destino por su cuenta,
# no hay que depender de esa autodeteccion (varia con el cwd y con la
# version): -c fija sin ambiguedad que config se usa, y convive con el
# -u GITLEAKS_CONFIG de arriba (uno fija la config, el otro impide que una
# variable de entorno la sustituya; no se pisan).
#
# QUE config, y por que se busca en vez de fijarla: antes se pasaba a ciegas
# "$REPO_ROOT/.gitleaks.toml", pero install.sh deja el fichero en
# $CLAUDE_HOME, que NO es la raiz del repo protegido. En cualquier repo sin
# ese fichero propio, gitleaks ni arrancaba ("unable to load gitleaks config")
# y, como este hook falla cerrado, el error de configuracion se convertia en
# un bloqueo permanente de TODOS los commits con un mensaje que apuntaba al
# sitio equivocado ("posibles secretos"). Orden: config del repo si la trae
# (override local legitimo), si no la que instala el kit.
CLAUDE_HOME_DIR="${CLAUDE_HOME:-$HOME/.claude}"
CONFIG=""
for c in "$REPO_ROOT/.gitleaks.toml" "$CLAUDE_HOME_DIR/.gitleaks.toml"; do
  [ -f "$c" ] && { CONFIG="$c"; break; }
done

if [ -n "$CONFIG" ]; then
  env -u GITLEAKS_CONFIG "$GITLEAKS" git --staged --no-banner --redact --ignore-gitleaks-allow -c "$CONFIG" "$REPO_ROOT"
else
  # Sin ninguna config disponible se escanea con las reglas por defecto de
  # gitleaks: pierde la regla propia del kit, pero cubrir de menos es mejor
  # que bloquear todo commit por un fichero ausente.
  echo "AVISO: sin .gitleaks.toml (ni en el repo ni en $CLAUDE_HOME_DIR); se usan las reglas por defecto." >&2
  env -u GITLEAKS_CONFIG "$GITLEAKS" git --staged --no-banner --redact --ignore-gitleaks-allow "$REPO_ROOT"
fi
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
  echo "BLOCKED: gitleaks encontro posibles secretos en los ficheros staged." >&2
  echo "Revisa el detalle arriba. Si es un falso positivo REAL (verificado contra gitleaks, no solo molesto), anadelo a .gitleaksignore con su fingerprint exacta -- queda en el diff del commit que lo añade, es auditable. No lo silencies con un comentario gitleaks:allow en el contenido: este hook lo ignora a proposito (--ignore-gitleaks-allow)." >&2
fi

exit "$STATUS"
