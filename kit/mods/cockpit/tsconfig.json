{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "typeRoots": [".claude-plugin/types"],
    "types": ["claude-code"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": ["types", "hooks", "tests"]
}
